# Supplemental HDMI clocks; root sys_clk is already named free_clk by DDR FDC.
create_generated_clock -name pixel_clk -source [get_ports {sys_clk}] -master_clock [get_clocks {free_clk}] -multiply_by 40 -divide_by 27 [get_pins {clocks.pll/clkout0}]
create_generated_clock -name cfg_clk -source [get_ports {sys_clk}] -master_clock [get_clocks {free_clk}] -multiply_by 10 -divide_by 27 [get_pins {clocks.pll/clkout1}]
create_clock -name rx_pixel_clk -period 25.000 [get_ports {pixclk_in}]

# RX telemetry: registered Gray source is40MHz; snapshot bundle held through ack.
set_max_delay 20.0 -datapath_only -from [get_cells {rx_telemetry.gray?*?}] -to [get_cells {rx_telemetry.gray_meta*}]
set_max_skew 20.0 -from [get_cells {rx_telemetry.gray?*?}] -to [get_cells {rx_telemetry.gray_meta*}]
set_max_delay 150.0 -datapath_only -from [get_cells {rx_telemetry.stable_status*}] -to [get_cells {rx_telemetry.snapshot*}]
set_false_path -from [get_clocks {cfg_clk}] -to [get_cells {rx_telemetry.req_sync* rx_enable_sync* rx_health_sync*}]
set_false_path -from [get_clocks {rx_pixel_clk}] -to [get_cells {rx_telemetry.ack_sync*}]
set_false_path -to [get_pins {rx_telemetry.pixel_release*/C rx_reset_release*/C}]

# Independent HDMI health observations; local meta->sync paths stay timed.
set_false_path -from [get_clocks {cfg_clk pixel_clk rx_pixel_clk}] -to [get_cells {hdmi_status_meta*}]

# FIFO pointer CDC: each bound is below the corresponding source update period.
# No clock-group or setup false-path exception may cover these buses.
set_max_delay 20.0 -datapath_only -from [get_cells {ingress.fifo.wr_gray?*?}] -to [get_cells {ingress.fifo.wr_gray_rd_sync1*}]
set_max_skew 20.0 -from [get_cells {ingress.fifo.wr_gray?*?}] -to [get_cells {ingress.fifo.wr_gray_rd_sync1*}]
set_max_delay 6.0 -datapath_only -from [get_cells {ingress.fifo.rd_gray?*?}] -to [get_cells {ingress.fifo.rd_gray_wr_sync1*}]
set_max_skew 6.0 -from [get_cells {ingress.fifo.rd_gray?*?}] -to [get_cells {ingress.fifo.rd_gray_wr_sync1*}]

# Scalar command and sticky status synchronizers: first stage only.
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {ingress.arm_sync1 ingress.cancel_sync1}]
set_false_path -from [get_clocks {rx_pixel_clk}] -to [get_cells {ingress.fault_core_sync1 ingress.overflow_core_sync1}]

# New ingress reset assertion legs, scoped to asynchronous reset pins only.
# Local ingress_pixel_release/core_release recovery/removal remains timed.
# FIFO reset nets must not be used as RAM enables or other data inputs.
set_false_path -from [get_clocks {free_clk}] -to [get_pins {ingress_pixel_release*/C ingress.*/C ingress.*/P ingress.fifo.*/C ingress.fifo.*/P}]
