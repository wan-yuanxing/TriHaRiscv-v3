# Internal estimate only; scalar first stages excepted, held bundles bounded. No clock-group cuts.
create_clock -name core_clk -period 8.000 [get_ports {core_clk}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_raw.record_sync1 u_raw.done_sync1* u_raw.commit_ack_sync1 u_raw.release_ack_sync1 u_raw.fault_sync1}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_raw.request_sync1* u_raw.commit_sync1 u_raw.release_sync1 u_raw.scan_sync1 u_raw.underflow_sync1}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.mailbox_base* u_raw.mailbox_stride* u_raw.mailbox_frame* u_raw.mailbox_slot*}] -to [get_cells {u_raw.pending_base* u_raw.pending_stride* u_raw.pending_frame* u_raw.pending_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.req_base*}] -to [get_cells {u_raw.dma_base_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.req_stride*}] -to [get_cells {u_raw.dma_stride_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.req_row*}] -to [get_cells {u_raw.dma_row_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.bank_success*}] -to [get_cells {u_raw.bank_ready*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.active_frame* u_raw.active_slot*}] -to [get_cells {u_raw.commit_frame_id* u_raw.commit_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_raw.release_pixel_id* u_raw.release_pixel_slot*}] -to [get_cells {u_raw.release_frame_id* u_raw.release_slot*}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_renderer.u_pixels.u_context.request_meta u_renderer.u_pixels.core_fault_meta u_renderer.u_asset.u_cache.ready_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_renderer.u_pixels.u_context.ack_meta u_renderer.u_pixels.u_context.error_meta u_renderer.u_pixels.fault_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_renderer.u_pixels.u_context.mailbox_payload*}] -to [get_cells {u_renderer.u_pixels.u_context.pixel_payload*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_renderer.u_asset.u_cache.asset_id* u_renderer.u_asset.u_cache.asset_generation*}] -to [get_cells {u_renderer.u_asset.u_cache.pixel_asset_id* u_renderer.u_asset.u_cache.pixel_generation* u_renderer.pixel_id* u_renderer.pixel_generation*}]
# New generation bits follow the same frozen mailbox/event controls.
set_max_delay 6.000 -datapath_only -from [get_cells {u_raw.mailbox_generation*}] -to [get_cells {u_raw.pending_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_raw.active_generation*}] -to [get_cells {u_raw.commit_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_raw.release_pixel_generation*}] -to [get_cells {u_raw.release_generation*}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {core_reset_n online memory_fault display_urgent load_valid load_base* load_bytes* load_asset_id* load_generation* expected_crc* result_ready commit_ready m_arready m_rid* m_rdata* m_rresp* m_rlast m_rvalid submit_valid submit_mode_only submit_slot* submit_mode* submit_frame* submit_generation* submit_base* submit_stride* submit_seq* submit_data* reject_ready release_ready asset_retire_ready}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {core_reset_n online memory_fault display_urgent load_valid load_base* load_bytes* load_asset_id* load_generation* expected_crc* result_ready commit_ready m_arready m_rid* m_rdata* m_rresp* m_rlast m_rvalid submit_valid submit_mode_only submit_slot* submit_mode* submit_frame* submit_generation* submit_base* submit_stride* submit_seq* submit_data* reject_ready release_ready asset_retire_ready}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {load_ready result_valid result_success result_code* result_asset_id* result_generation* checked_bytes* crc* asset_ready asset_id* asset_generation* words_written* commit_valid commit_mode* commit_slot* commit_frame* commit_generation* commit_seq* faults* read_code* material_code* pixels_code* port_drained raw_grants* asset_grants* m_arid* m_araddr* m_arlen* m_arsize* m_arburst* m_arvalid m_rready submit_ready reject_valid reject_code* reject_seq* commit_mode_only release_valid release_slot* release_frame* release_generation* active_valid active_slot* active_mode* active_frame* active_generation* slot_free* asset_retire_valid asset_retire_slot* asset_retire_frame* asset_retire_generation* asset_retire_seq* asset_retire_id* asset_retire_generation_id* owner_error link_error raw_error fault owner_code* link_code* raw_code* raw_commits* raw_scans* raw_lines* underflows*}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {load_ready result_valid result_success result_code* result_asset_id* result_generation* checked_bytes* crc* asset_ready asset_id* asset_generation* words_written* commit_valid commit_mode* commit_slot* commit_frame* commit_generation* commit_seq* faults* read_code* material_code* pixels_code* port_drained raw_grants* asset_grants* m_arid* m_araddr* m_arlen* m_arsize* m_arburst* m_arvalid m_rready submit_ready reject_valid reject_code* reject_seq* commit_mode_only release_valid release_slot* release_frame* release_generation* active_valid active_slot* active_mode* active_frame* active_generation* slot_free* asset_retire_valid asset_retire_slot* asset_retire_frame* asset_retire_generation* asset_retire_seq* asset_retire_id* asset_retire_generation_id* owner_error link_error raw_error fault owner_code* link_code* raw_code* raw_commits* raw_scans* raw_lines* underflows*}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_reset_n pixel_x* pixel_y* pixel_de pixel_hs pixel_vs pixel_frame_start}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_reset_n pixel_x* pixel_y* pixel_de pixel_hs pixel_vs pixel_frame_start}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_material_ready raw_context_valid raw_slot* raw_frame* raw_generation* raw_x* raw_y* raw_rgb* raw_de raw_hs raw_vs raw_sof out_rgb* out_x* out_y* out_frame* out_generation* out_seq* out_slot* out_mode* out_de out_hs out_vs out_sof out_box out_point out_avatar out_fault pixel_pending pending_mode* pending_slot* pending_frame* pending_generation*}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_material_ready raw_context_valid raw_slot* raw_frame* raw_generation* raw_x* raw_y* raw_rgb* raw_de raw_hs raw_vs raw_sof out_rgb* out_x* out_y* out_frame* out_generation* out_seq* out_slot* out_mode* out_de out_hs out_vs out_sof out_box out_point out_avatar out_fault pixel_pending pending_mode* pending_slot* pending_frame* pending_generation*}]
