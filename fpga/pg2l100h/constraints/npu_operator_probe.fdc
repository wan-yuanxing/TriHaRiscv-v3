# 100MHz component with a registered scan boundary, not board pin timing.
create_clock -name core_clk -period 10.000 [get_ports {clk_i}]
set_clock_uncertainty -setup 0.100 [get_clocks {core_clk}]
set_clock_uncertainty -hold 0.050 [get_clocks {core_clk}]
set_input_delay -clock core_clk -max 2.000 [get_ports {rst_ni scan_i scan_shift_i capture_i}]
set_input_delay -clock core_clk -min 0.500 [get_ports {rst_ni scan_i scan_shift_i capture_i}]
set_output_delay -clock core_clk -max 2.000 [get_ports {scan_o}]
set_output_delay -clock core_clk -min 0.500 [get_ports {scan_o}]
