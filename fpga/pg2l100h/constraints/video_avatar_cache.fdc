# Complete write/seal precedes readiness. RAM does not rely on reset clearing.
create_clock -name core_clk -period 8.000 [get_ports {core_clk}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {ready_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {asset_id* asset_generation*}] -to [get_cells {pixel_asset_id* pixel_generation*}]
