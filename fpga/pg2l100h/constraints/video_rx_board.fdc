create_clock -name rx_pixel_clk -period 25.000 [get_ports {pixclk_in}]
# CDC only: registeredGray must arrive before the next source increment.
set_max_delay 20.0 -datapath_only -from [get_cells {telemetry.gray?*?}] -to [get_cells {telemetry.gray_meta*}]
set_max_skew 20.0 -from [get_cells {telemetry.gray?*?}] -to [get_cells {telemetry.gray_meta*}]
# Source bundle is held through req/ack; destination waits2FF+extra edge.
set_max_delay 150.0 -datapath_only -from [get_cells {telemetry.stable_status*}] -to [get_cells {telemetry.snapshot*}]
# Single-bit handshake/control/reset assertion crossings; subsequent stages timed.
set_false_path -from [get_clocks {cfg_clk}] -to [get_cells {telemetry.req_sync* rx_enable_sync*}]
set_false_path -from [get_clocks {rx_pixel_clk}] -to [get_cells {telemetry.ack_sync*}]
set_false_path -to [get_pins {telemetry.pixel_release*/C rx_reset_release*/C}]
