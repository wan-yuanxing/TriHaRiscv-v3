# Diagnostic composition estimate, not a board target or external AC contract.
create_clock -name core_clk -period 8.000 [get_ports {core_clk}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_ports {mode_button_n}] -to [get_cells {mode_button.button_meta}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {mode_cdc.request_meta avatar_cache.ready_meta live_meta context_fault_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {mode_cdc.ack_meta mode_cdc.error_meta overlay_fault_meta cache_ready_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {mode_cdc.mailbox_payload*}] -to [get_cells {mode_cdc.pixel_payload*}]
set_max_delay 6.000 -datapath_only -from [get_cells {avatar_cache.asset_id* avatar_cache.asset_generation*}] -to [get_cells {avatar_cache.pixel_asset_id* avatar_cache.pixel_generation*}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {context_*}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {context_*}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {raw_*}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {raw_*}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {out_* mode_first_pixel}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {out_* mode_first_pixel}]
