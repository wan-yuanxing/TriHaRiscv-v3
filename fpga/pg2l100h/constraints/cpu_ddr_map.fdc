# Area-only fixture clocks. No asynchronous timing exception or signoff claim.
create_clock -name cpu_clk -period 10.000 [get_ports {cpu_clk_i}]
create_clock -name ddr_clk -period 8.000 [get_ports {ddr_clk_i}]
set_clock_uncertainty 0.100 -from [get_clocks {cpu_clk}] -to [get_clocks {cpu_clk}] -setup
set_clock_uncertainty 0.050 -from [get_clocks {cpu_clk}] -to [get_clocks {cpu_clk}] -hold
set_input_delay 2.000 -clock [get_clocks {cpu_clk}] -max [get_ports {rst_ni shift_i capture_i scan_i}]
set_input_delay 0.500 -clock [get_clocks {cpu_clk}] -min [get_ports {rst_ni shift_i capture_i scan_i}]
set_output_delay 2.000 -clock [get_clocks {cpu_clk}] -max [get_ports {scan_o}]
set_output_delay 0.500 -clock [get_clocks {cpu_clk}] -min [get_ports {scan_o}]
