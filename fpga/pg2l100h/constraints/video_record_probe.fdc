# Generated component scan boundary. No physical board or global CDC claim.
# PDS scopeattr.tcl: port-level I/O ring register packing preference.
define_attribute {p:core_scan_o} {syn_useioff} {1}
create_clock -name core_clk -period 8.000 [get_ports {clk_i}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_pipeline.u_display.u_raw.record_sync1 u_pipeline.u_display.u_raw.done_sync1* u_pipeline.u_display.u_raw.commit_ack_sync1 u_pipeline.u_display.u_raw.release_ack_sync1 u_pipeline.u_display.u_raw.fault_sync1}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_pipeline.u_display.u_raw.request_sync1* u_pipeline.u_display.u_raw.commit_sync1 u_pipeline.u_display.u_raw.release_sync1 u_pipeline.u_display.u_raw.scan_sync1 u_pipeline.u_display.u_raw.underflow_sync1}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.mailbox_base* u_pipeline.u_display.u_raw.mailbox_stride* u_pipeline.u_display.u_raw.mailbox_frame* u_pipeline.u_display.u_raw.mailbox_slot*}] -to [get_cells {u_pipeline.u_display.u_raw.pending_base* u_pipeline.u_display.u_raw.pending_stride* u_pipeline.u_display.u_raw.pending_frame* u_pipeline.u_display.u_raw.pending_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.req_base*}] -to [get_cells {u_pipeline.u_display.u_raw.dma_base_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.req_stride*}] -to [get_cells {u_pipeline.u_display.u_raw.dma_stride_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.req_row*}] -to [get_cells {u_pipeline.u_display.u_raw.dma_row_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.bank_success*}] -to [get_cells {u_pipeline.u_display.u_raw.bank_ready*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.active_frame* u_pipeline.u_display.u_raw.active_slot*}] -to [get_cells {u_pipeline.u_display.u_raw.commit_frame_id* u_pipeline.u_display.u_raw.commit_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.release_pixel_id* u_pipeline.u_display.u_raw.release_pixel_slot*}] -to [get_cells {u_pipeline.u_display.u_raw.release_frame_id* u_pipeline.u_display.u_raw.release_slot*}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_pipeline.u_display.u_renderer.u_pixels.u_context.request_meta u_pipeline.u_display.u_renderer.u_pixels.core_fault_meta u_pipeline.u_display.u_renderer.u_asset.u_cache.ready_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_pipeline.u_display.u_renderer.u_pixels.u_context.ack_meta u_pipeline.u_display.u_renderer.u_pixels.u_context.error_meta u_pipeline.u_display.u_renderer.u_pixels.fault_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_pipeline.u_display.u_renderer.u_pixels.u_context.mailbox_payload*}] -to [get_cells {u_pipeline.u_display.u_renderer.u_pixels.u_context.pixel_payload*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_pipeline.u_display.u_renderer.u_asset.u_cache.asset_id* u_pipeline.u_display.u_renderer.u_asset.u_cache.asset_generation*}] -to [get_cells {u_pipeline.u_display.u_renderer.u_asset.u_cache.pixel_asset_id* u_pipeline.u_display.u_renderer.u_asset.u_cache.pixel_generation* u_pipeline.u_display.u_renderer.pixel_id* u_pipeline.u_display.u_renderer.pixel_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.mailbox_generation*}] -to [get_cells {u_pipeline.u_display.u_raw.pending_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.active_generation*}] -to [get_cells {u_pipeline.u_display.u_raw.commit_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_pipeline.u_display.u_raw.release_pixel_generation*}] -to [get_cells {u_pipeline.u_display.u_raw.release_generation*}]
set_clock_uncertainty -setup 0.100 [get_clocks {core_clk}]
set_clock_uncertainty -hold 0.050 [get_clocks {core_clk}]
set_input_delay 2.000 -clock [get_clocks {core_clk}] -max [get_ports {rst_ni core_scan_i core_shift_i core_capture_i}]
set_output_delay 2.000 -clock [get_clocks {core_clk}] -max [get_ports {core_scan_o}]
set_input_delay 0.500 -clock [get_clocks {core_clk}] -min [get_ports {rst_ni core_scan_i core_shift_i core_capture_i}]
set_output_delay 0.500 -clock [get_clocks {core_clk}] -min [get_ports {core_scan_o}]
set_clock_uncertainty -setup 0.100 [get_clocks {pixel_clk}]
set_clock_uncertainty -hold 0.050 [get_clocks {pixel_clk}]
set_input_delay 2.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_reset_n pixel_scan_i pixel_shift_i pixel_capture_i}]
set_output_delay 2.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_scan_o}]
set_input_delay 0.500 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_reset_n pixel_scan_i pixel_shift_i pixel_capture_i}]
set_output_delay 0.500 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_scan_o}]
