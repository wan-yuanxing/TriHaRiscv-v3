define_attribute {i:u_core/u_cpu/u_div} {PAP_REGION} {soc_cpu_datapath(0,64,100,149)}
define_attribute {i:u_core/u_cpu/u_lsu} {PAP_REGION} {soc_cpu_datapath(0,64,100,149)}
define_attribute {i:u_core/u_cpu/u_frontend/u_decode} {PAP_REGION} {soc_cpu_datapath(0,64,100,149)}
