# Internal component; scalar synchronizers and held bundles only, no clock-group cut.
create_clock -name core_clk -period 8.000 [get_ports {core_clk}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_pixels.u_context.request_meta u_pixels.core_fault_meta u_asset.u_cache.ready_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_pixels.u_context.ack_meta u_pixels.u_context.error_meta u_pixels.fault_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_pixels.u_context.mailbox_payload*}] -to [get_cells {u_pixels.u_context.pixel_payload*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_asset.u_cache.asset_id* u_asset.u_cache.asset_generation*}] -to [get_cells {u_asset.u_cache.pixel_asset_id* u_asset.u_cache.pixel_generation* pixel_id* pixel_generation*}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {core_reset_n online memory_fault display_urgent load_valid load_base* load_bytes* load_asset_id* load_generation* expected_crc* result_ready cmd_valid cmd_mode* cmd_slot* cmd_frame* cmd_generation* cmd_seq* cmd_data* commit_ready retire_ready d_arid* d_araddr* d_arlen* d_arsize* d_arburst* d_arvalid d_rready m_arready m_rid* m_rdata* m_rresp* m_rlast m_rvalid}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {core_reset_n online memory_fault display_urgent load_valid load_base* load_bytes* load_asset_id* load_generation* expected_crc* result_ready cmd_valid cmd_mode* cmd_slot* cmd_frame* cmd_generation* cmd_seq* cmd_data* commit_ready retire_ready d_arid* d_araddr* d_arlen* d_arsize* d_arburst* d_arvalid d_rready m_arready m_rid* m_rdata* m_rresp* m_rlast m_rvalid}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {load_ready result_valid result_success result_code* result_asset_id* result_generation* checked_bytes* crc* asset_ready asset_id* asset_generation* words_written* cmd_ready commit_valid commit_mode* commit_slot* commit_frame* commit_generation* commit_seq* retire_valid retire_slot* retire_mode* retire_frame* retire_generation* retire_seq* retire_raw retire_asset retire_asset_id* retire_asset_generation* faults* read_code* material_code* pixels_code* port_drained raw_grants* asset_grants* d_arready d_rid* d_rdata* d_rresp* d_rlast d_rvalid m_arid* m_araddr* m_arlen* m_arsize* m_arburst* m_arvalid m_rready}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {load_ready result_valid result_success result_code* result_asset_id* result_generation* checked_bytes* crc* asset_ready asset_id* asset_generation* words_written* cmd_ready commit_valid commit_mode* commit_slot* commit_frame* commit_generation* commit_seq* retire_valid retire_slot* retire_mode* retire_frame* retire_generation* retire_seq* retire_raw retire_asset retire_asset_id* retire_asset_generation* faults* read_code* material_code* pixels_code* port_drained raw_grants* asset_grants* d_arready d_rid* d_rdata* d_rresp* d_rlast d_rvalid m_arid* m_araddr* m_arlen* m_arsize* m_arburst* m_arvalid m_rready}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_reset_n raw_context_valid raw_slot* raw_frame* raw_generation* raw_x* raw_y* raw_rgb* raw_de raw_hs raw_vs raw_sof}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_reset_n raw_context_valid raw_slot* raw_frame* raw_generation* raw_x* raw_y* raw_rgb* raw_de raw_hs raw_vs raw_sof}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {out_* pixel_material_ready pixel_pending pending_*}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {out_* pixel_material_ready pixel_pending pending_*}]
