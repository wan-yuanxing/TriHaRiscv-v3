# Status observations: only paths launched in the opposite clock domain
# enter these two-flop synchronizers. No FIFO payload/Gray paths are cut.
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {g_full.impl/face/model_seal_sync* g_full.impl/face/video_irq_sync* g_full.impl/face/u_compute_cdc/ready_meta_q g_full.impl/face/u_compute_cdc/fault_meta_q}]
