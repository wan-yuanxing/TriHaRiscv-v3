# CDC protocol constraints: checked against RTL and PDS compile endpoints.
# Bounded mailbox/Gray data paths remain timed; only opposite-domain synchronizer inputs are cut.
# Full avatar cache: identity latches before the 65536-word load and remains
# immutable until coordinated reset. Readiness crosses two pixel-clock flops;
# the cache and renderer then capture the held identity. Only ready_meta is cut.
# Generate-scope spellings and both identity destinations verified in PDS compile DB.
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/g_avatar.g_full_cache.u_asset/u_cache/ready_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/g_avatar.g_full_cache.u_asset/u_cache/asset_id* g_full.impl/face/u_video/g_compact.u_display/u_renderer/g_avatar.g_full_cache.u_asset/u_cache/asset_generation*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/g_avatar.g_full_cache.u_asset/u_cache/pixel_asset_id* g_full.impl/face/u_video/g_compact.u_display/u_renderer/g_avatar.g_full_cache.u_asset/u_cache/pixel_generation* g_full.impl/face/u_video/g_compact.u_display/u_renderer/pixel_id* g_full.impl/face/u_video/g_compact.u_display/u_renderer/pixel_generation*}]
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/record_sync1 g_full.impl/face/u_video/g_compact.u_display/u_raw/done_sync1* g_full.impl/face/u_video/g_compact.u_display/u_raw/commit_ack_sync1 g_full.impl/face/u_video/g_compact.u_display/u_raw/release_ack_sync1 g_full.impl/face/u_video/g_compact.u_display/u_raw/fault_sync1}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/request_sync1* g_full.impl/face/u_video/g_compact.u_display/u_raw/commit_sync1 g_full.impl/face/u_video/g_compact.u_display/u_raw/release_sync1 g_full.impl/face/u_video/g_compact.u_display/u_raw/scan_sync1 g_full.impl/face/u_video/g_compact.u_display/u_raw/underflow_sync1}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/mailbox_base* g_full.impl/face/u_video/g_compact.u_display/u_raw/mailbox_stride* g_full.impl/face/u_video/g_compact.u_display/u_raw/mailbox_frame* g_full.impl/face/u_video/g_compact.u_display/u_raw/mailbox_slot*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/pending_base* g_full.impl/face/u_video/g_compact.u_display/u_raw/pending_stride* g_full.impl/face/u_video/g_compact.u_display/u_raw/pending_frame* g_full.impl/face/u_video/g_compact.u_display/u_raw/pending_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/req_base*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/dma_base_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/req_stride*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/dma_stride_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/req_row*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/dma_row_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/bank_success*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/bank_ready*}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/active_frame* g_full.impl/face/u_video/g_compact.u_display/u_raw/active_slot*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/commit_frame_id* g_full.impl/face/u_video/g_compact.u_display/u_raw/commit_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/release_pixel_id* g_full.impl/face/u_video/g_compact.u_display/u_raw/release_pixel_slot*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/release_frame_id* g_full.impl/face/u_video/g_compact.u_display/u_raw/release_slot*}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/ack_meta g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/error_meta g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/fault_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/mailbox_payload*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/pixel_payload*}]
set_max_delay 6.000 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/mailbox_generation*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/pending_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/active_generation*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/commit_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/release_pixel_generation*}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_raw/release_generation*}]
# Compact owner holds the complete record before request synchronization until
# combined scanner/pixel feedback. Bound every pixel-domain data/control sink
# fed by this exact source bank: active_data capture and asset admission.
# Overlay uses only pixel-local active_data; no payload false path or clock-group cut.
set_max_delay 6.000 -datapath_only -from [get_cells {g_full.impl/face/u_video/g_compact.u_display/g_full_mmio.u_mmio/record_data*}] -to [get_clocks {pixel_clk}]
# Either domain can assert the lease reset. Deassertion is synchronized locally;
# only the two async clear pins of the opposite-domain release chain are cut.
set_false_path -from [get_clocks {pixel_clk}] -to [get_pins {g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/core_release[1:0]/C}]
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_pins {g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/pixel_release[1:0]/C}]
# Ingress Gray buses stay bounded below their source periods; no clock-group cuts.
set_max_delay 20.0 -datapath_only -from [get_cells -regexp {^g_full[.]impl/ingress/fifo/wr_gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/ingress/fifo/wr_gray_rd_sync1*}]
set_max_skew 20.0 -from [get_cells -regexp {^g_full[.]impl/ingress/fifo/wr_gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/ingress/fifo/wr_gray_rd_sync1*}]
set_max_delay 6.0 -datapath_only -from [get_cells -regexp {^g_full[.]impl/ingress/fifo/rd_gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/ingress/fifo/rd_gray_wr_sync1*}]
set_max_skew 6.0 -from [get_cells -regexp {^g_full[.]impl/ingress/fifo/rd_gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/ingress/fifo/rd_gray_wr_sync1*}]
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {g_full.impl/ingress/arm_sync1 g_full.impl/ingress/cancel_sync1}]
set_false_path -from [get_clocks {rx_pixel_clk}] -to [get_cells {g_full.impl/ingress/fault_core_sync1 g_full.impl/ingress/overflow_core_sync1}]
# RX telemetry: source Gray updates at 40 MHz; bundle held through request/ack.
set_max_delay 20.0 -datapath_only -from [get_cells -regexp {^g_full[.]impl/rx_telemetry/gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/rx_telemetry/gray_meta*}]
set_max_skew 20.0 -from [get_cells -regexp {^g_full[.]impl/rx_telemetry/gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/rx_telemetry/gray_meta*}]
set_max_delay 150.0 -datapath_only -from [get_cells {g_full.impl/rx_telemetry/stable_status*}] -to [get_cells {g_full.impl/rx_telemetry/snapshot*}]
set_false_path -from [get_clocks {cfg_clk}] -to [get_cells {g_full.impl/rx_telemetry/req_sync* g_full.impl/rx_enable_sync* g_full.impl/rx_health_sync*}]
set_false_path -from [get_clocks {rx_pixel_clk}] -to [get_cells {g_full.impl/rx_telemetry/ack_sync*}]
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/u_context/request_meta g_full.impl/face/u_video/g_compact.u_display/u_renderer/u_pixels/core_fault_meta}]

# CPU/NPU 100 MHz <-> DDR/video 125 MHz. No clock-group false paths:
# Gray-pointer flight time AND bus skew are bounded below both periods.
# RAM payload remains timed; synchronizer stage 1 -> 2 remains timed.
set_max_delay 6.0 -datapath_only -from [get_cells -regexp {^g_full[.]impl/face/u_compute_cdc/u_aw_fifo/wr_gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/face/u_compute_cdc/u_aw_fifo/wr_gray_rd_sync1*}]
set_max_skew 6.0 -from [get_cells -regexp {^g_full[.]impl/face/u_compute_cdc/u_aw_fifo/wr_gray\[[0-9:]+\]$}] -to [get_cells {g_full.impl/face/u_compute_cdc/u_aw_fifo/wr_gray_rd_sync1*}]
