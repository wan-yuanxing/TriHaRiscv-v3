create_clock -name sys_clk -period 37.037037 [get_ports {sys_clk}]
# Clock roots and generated clocks used by the final top.  Keep the names and
# PLL paths aligned with the reusable HDMI board constraints so PDS can carry
# timing through the generate wrapper instead of treating these clocks as
# unconstrained data ports.
create_generated_clock -name pixel_clk -source [get_ports {sys_clk}] -master_clock [get_clocks {sys_clk}] -multiply_by 40 -divide_by 27 [get_pins {g_full.impl/clocks/pll/clkout0}]
create_generated_clock -name cfg_clk -source [get_ports {sys_clk}] -master_clock [get_clocks {sys_clk}] -multiply_by 10 -divide_by 27 [get_pins {g_full.impl/clocks/pll/clkout1}]
create_clock -name rx_pixel_clk -period 25.000 [get_ports {pixclk_in}]
create_clock -name ref_clk -period 8.000 -waveform {0 4.000} [get_ports {ref_clk_p}]
# Generated DDR IP timing contract, re-rooted only; generic IO pins are excluded.
create_generated_clock -name {rst_clk} -source [get_ports {ref_clk_p}] [get_pins {g_full.impl/I_ips_ddr_top.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {ref_clk_p}] [get_pins {g_full.impl/I_ips_ddr_top.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
# CPU/B03 uses a separate 50 MHz PLL derived from the same 125 MHz DDR
# reference.  The reusable SoC crosses this boundary through its AXI CDCs;
# constrain its synchronizers and Gray buses individually in triha_face_cdc.fdc.
create_generated_clock -name {compute_clk} -source [get_ports {ref_clk_p}] [get_pins {g_full.impl/compute_clock_gen/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {2} -divide_by {5}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {ref_clk_p}] [get_pins {g_full.impl/I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {g_full.impl/I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {g_full.impl/I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {ref_clk_p}] [get_pins {g_full.impl/I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
