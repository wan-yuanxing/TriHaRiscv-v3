# KEY0 asserts asynchronously; every internal domain has its own release chain.
set_false_path -from [get_ports {rst_in}]
# Only asynchronous assertion pins of explicit two-stage release chains.
# Same-domain meta-to-sync D paths and locally released reset paths remain timed.
set_false_path -from [get_clocks {sys_clk}] -to [get_pins {g_full.impl/core_release*/C g_full.impl/display_release*/C g_full.impl/ingress_release*/C}]
# Compute AXI/AXI-Lite reset synchronizers: only their four async-clear inputs.
# Each first D is constant 1; each second D is fed only by its first Q.
# Local release fanout, status resets and both inter-stage D paths remain timed.
# scripts/soc/check_face_reset_constraints.py audits synthesized chain topology.
# Literal bus pins were queried in PDS before synthesis bit splitting.
set_false_path -from [get_clocks {sys_clk}] -to [get_pins {g_full.impl/face/u_compute_cdc/cpu_release_q[1:0]/C g_full.impl/face/u_control_cdc/s_release[1:0]/C}]
set_false_path -from [get_clocks {sys_clk}] -to [get_pins {g_full.impl/I_ips_ddr_top.u_ddrc_rstn_sync.sig_async_r*/C}]

# Startup-only source exception survives PDS FSM recoding. Exact production
# netlist audit (20261101T063504_655125Z) reaches 47 C + 1 P core pins, no
# data/CE/RAM pins. Local core_release paths remain fully timed.
# Vendor phase ingress keeps the pinned startup protocol: PLL release guard
# at edge 202, START=0, 26 functional FFs hold reset values across release.
# See docs/verification/npu/2026-11-01-face-timing-progress.json.
set_false_path -from [get_cells {g_full.impl/free_release* g_full.impl/startup_done}] -to [get_clocks {ddrphy_sysclk}]
