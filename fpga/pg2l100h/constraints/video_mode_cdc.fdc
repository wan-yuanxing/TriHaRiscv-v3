# Component estimate. Local stages timed; no whole clock-group exception.
create_clock -name core_clk -period 8.000 [get_ports {core_clk}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {request_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {ack_meta error_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {mailbox_payload*}] -to [get_cells {pixel_payload*}]
