define_attribute {p:led_o[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led_o[2]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led_o[2]} {PAP_IO_DRIVE} {4}
define_attribute {p:led_o[2]} {PAP_IO_NONE} {TRUE}
define_attribute {p:led_o[2]} {PAP_IO_SLEW} {FAST}
define_attribute {p:led_o[3]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_o[3]} {PAP_IO_LOC} {E18}
define_attribute {p:led_o[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led_o[3]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led_o[3]} {PAP_IO_DRIVE} {8}
define_attribute {p:led_o[3]} {PAP_IO_NONE} {TRUE}
define_attribute {p:led_o[3]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:ref_clk_pi} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ref_clk_pi} {PAP_IO_LOC} {N3}
define_attribute {p:ref_clk_pi} {PAP_IO_VCCIO} {1.5}
define_attribute {p:ref_clk_pi} {PAP_IO_STANDARD} {SSTL15D_I}
define_attribute {p:ref_clk_pi} {PAP_IO_NONE} {TRUE}
define_attribute {p:ref_clk_ni} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ref_clk_ni} {PAP_IO_LOC} {N2}
define_attribute {p:ref_clk_ni} {PAP_IO_VCCIO} {1.5}
define_attribute {p:ref_clk_ni} {PAP_IO_STANDARD} {SSTL15D_I}
define_attribute {p:ref_clk_ni} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx_o} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx_o} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx_o} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx_o} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx_o} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx_o} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx_o} {PAP_IO_SLEW} {SLOW}


# Actual shared125MHz reference -> CPU100MHz PLL, original CPU IO/hold budgets.
create_generated_clock -name cpu_clk -source [get_ports {ref_clk_pi}] -multiply_by 4 -divide_by 5 [get_pins {u_cpu_pll/clkout0}]
set_clock_uncertainty 0.100 -from [get_clocks {cpu_clk}] -to [get_clocks {cpu_clk}] -setup
set_clock_uncertainty 0.050 -from [get_clocks {cpu_clk}] -to [get_clocks {cpu_clk}] -hold
set_input_delay 2.000 -clock [get_clocks {cpu_clk}] -max [get_ports {rst_ni}]
set_input_delay 0.500 -clock [get_clocks {cpu_clk}] -min [get_ports {rst_ni}]
set_output_delay 2.000 -clock [get_clocks {cpu_clk}] -max [get_ports {uart_tx_o}]
set_output_delay 0.500 -clock [get_clocks {cpu_clk}] -min [get_ports {uart_tx_o}]
set_output_delay 2.000 -clock [get_clocks {free_clk}] -max [get_ports {led_o*}]
set_output_delay 0.500 -clock [get_clocks {free_clk}] -min [get_ports {led_o*}]
define_global_attribute {syn_useioff} {1}

# Only asynchronous first-stage D pins; second-stage synchronizers remain timed.
set_false_path -to [get_pins {u_system.u_cdc.ready_meta_q/D* u_system.u_cdc.fault_meta_q/D* u_supervisor.status_meta_q*/D* u_supervisor.beat_meta_q/D* software_meta_q*/D* board_fault_meta_q/D*}]
# Free-domain epoch launch reaches asynchronous reset pins only. Same-domain
# release-register recovery/removal and all D/CE/RAM data paths remain timed.
set_false_path -from [get_ports {rst_ni}] -to [get_pins {u_supervisor.free_release_q*/C}]
set_false_path -from [get_clocks {free_clk}] -to [get_pins {reference_release_q*/C u_supervisor.ddr_release_q*/C u_system.u_cdc.cpu_release_q*/C u_system.u_cdc.ddr_release_q*/C I_ips_ddr_top.u_ddrc_rstn_sync.sig_async_r*/C}]
# Preserve the pinned vendor phase-adjust reset protocol and startup hold.
set_false_path -from [get_clocks {free_clk}] -to [get_pins {I_ips_ddr_top.u_ddrphy_top.u_ips2l_ddrphy_rst_clk_phase_adj.*/C I_ips_ddr_top.u_ddrphy_top.u_ips2l_ddrphy_rst_clk_phase_adj.*/P}]
set_max_delay 8.000 -datapath_only -from [get_pins -regexp -hsc / {u_system/u_cdc/u_aw_fifo/wr_gray\[[0-9:]+\]/Q(\[[0-9]+\])?}] -to [get_pins -regexp -hsc / {u_system/u_cdc/u_aw_fifo/wr_gray_rd_sync1\[[0-9:]+\]/D(\[[0-9]+\])?}]
set_max_skew 2.000 -from [get_pins -regexp -hsc / {u_system/u_cdc/u_aw_fifo/wr_gray\[[0-9:]+\]/Q(\[[0-9]+\])?}] -to [get_pins -regexp -hsc / {u_system/u_cdc/u_aw_fifo/wr_gray_rd_sync1\[[0-9:]+\]/D(\[[0-9]+\])?}]
