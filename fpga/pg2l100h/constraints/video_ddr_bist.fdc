define_attribute {p:init_over_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:init_over_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:init_over_rx} {PAP_IO_DRIVE} {4}
define_attribute {p:init_over_rx} {PAP_IO_NONE} {TRUE}
define_attribute {p:init_over_rx} {PAP_IO_SLEW} {FAST}
define_attribute {p:hdmi_int_led} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:hdmi_int_led} {PAP_IO_LOC} {E18}
define_attribute {p:hdmi_int_led} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_int_led} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_int_led} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_int_led} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_int_led} {PAP_IO_SLEW} {SLOW}
define_attribute {p:ref_clk_p} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ref_clk_p} {PAP_IO_LOC} {N3}
define_attribute {p:ref_clk_p} {PAP_IO_VCCIO} {1.5}
define_attribute {p:ref_clk_p} {PAP_IO_STANDARD} {SSTL15D_I}
define_attribute {p:ref_clk_p} {PAP_IO_NONE} {TRUE}
define_attribute {p:ref_clk_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:ref_clk_n} {PAP_IO_LOC} {N2}
define_attribute {p:ref_clk_n} {PAP_IO_VCCIO} {1.5}
define_attribute {p:ref_clk_n} {PAP_IO_STANDARD} {SSTL15D_I}
define_attribute {p:ref_clk_n} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}

# Bounded bundled-data CDC. Source is held for the full request/ack cycle.
# At27MHz destination samples >=3 free periods after source hold (>111ns).
# The80ns route bound leaves >=31ns for settling; same-domain BIST stays timed.
set_max_delay 80.0 -datapath_only -from [get_cells {telemetry.stable_status*}] -to [get_cells {telemetry.snapshot*}]
# First synchronizer stages only; do not globally isolate free_clk and core_clk.
set_false_path -from [get_clocks {free_clk}] -to [get_cells {telemetry.req_meta telemetry.source_release* core_release*}]
set_false_path -from [get_clocks {ddrphy_sysclk}] -to [get_cells {telemetry.ack_meta}]
set_false_path -from [get_clocks {ref_clk rst_clk ddrphy_sysclk phy_dq_clk_0 phy_dq_clk_1 phy_dq_sysclk_0 phy_dq_sysclk_1}] -to [get_cells {status_meta*}]
# External KEY0 is an asynchronous reset. Internal reset-release chains are explicit.
set_false_path -from [get_ports {rst_in}]

# Raw asynchronous reset assertion legs. Local core/source release flops still
# time their same-domain recovery/removal paths; no data path is exempted.
set_false_path -from [get_clocks {free_clk}] -to [get_pins {bist.*/C bist.*/P telemetry.req_meta/C telemetry.req_sync/C telemetry.ack/C telemetry.stable_status*/C}]
set_false_path -from [get_clocks {free_clk}] -to [get_pins {I_ips_ddr_top.u_ddrc_rstn_sync.sig_async_r*/C}]
# Pinned vendor phase-adjust ingress is NOT a synchronized reset release.
# Exact netlist review: START is held0 in normal bring-up; 26 functional flops
# retain reset values for >=2 core edges, 6 pipeline flops absorb START/DONE.
# Preserve that vendor startup protocol and the1ms external reset hold. This
# pin-scoped reset-protocol exception does not sign off analog reset recovery.
set_false_path -from [get_clocks {free_clk}] -to [get_pins {I_ips_ddr_top.u_ddrphy_top.u_ips2l_ddrphy_rst_clk_phase_adj.*/C I_ips_ddr_top.u_ddrphy_top.u_ips2l_ddrphy_rst_clk_phase_adj.*/P}]
# These two independent-domain registers feed the core domain exclusively as
# asynchronous reset sources. Select launch objects so PDS FSM recoding cannot
# discard sink reset-pin annotations; local core release/data paths stay timed.
# Exact flattened netlist audit found405 C/P sinks and zero core D/CE/RAM sinks.
set_false_path -from [get_cells {free_release* startup_done}] -to [get_clocks {ddrphy_sysclk}]
