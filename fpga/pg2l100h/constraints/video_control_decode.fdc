# Same-clock internal component estimate; no CDC or board assumption.
create_clock -name core_clk -period 8.000 [get_ports {clk_i}]
set_input_delay 2.000 -clock [get_clocks {core_clk}] -max [get_ports {rst_ni s_axi_awaddr_i* s_axi_awprot_i* s_axi_awvalid_i m_axi_awready_i* s_axi_wdata_i* s_axi_wstrb_i* s_axi_wvalid_i m_axi_wready_i* m_axi_bresp_i* m_axi_bvalid_i* s_axi_bready_i s_axi_araddr_i* s_axi_arprot_i* s_axi_arvalid_i m_axi_arready_i* m_axi_rdata_i* m_axi_rresp_i* m_axi_rvalid_i* s_axi_rready_i}]
set_input_delay 0.500 -clock [get_clocks {core_clk}] -min [get_ports {rst_ni s_axi_awaddr_i* s_axi_awprot_i* s_axi_awvalid_i m_axi_awready_i* s_axi_wdata_i* s_axi_wstrb_i* s_axi_wvalid_i m_axi_wready_i* m_axi_bresp_i* m_axi_bvalid_i* s_axi_bready_i s_axi_araddr_i* s_axi_arprot_i* s_axi_arvalid_i m_axi_arready_i* m_axi_rdata_i* m_axi_rresp_i* m_axi_rvalid_i* s_axi_rready_i}]
set_output_delay 2.000 -clock [get_clocks {core_clk}] -max [get_ports {m_axi_awaddr_o* m_axi_awprot_o* m_axi_awvalid_o* s_axi_awready_o m_axi_wdata_o* m_axi_wstrb_o* m_axi_wvalid_o* s_axi_wready_o s_axi_bresp_o* s_axi_bvalid_o m_axi_bready_o* m_axi_araddr_o* m_axi_arprot_o* m_axi_arvalid_o* s_axi_arready_o s_axi_rdata_o* s_axi_rresp_o* s_axi_rvalid_o m_axi_rready_o*}]
set_output_delay 0.500 -clock [get_clocks {core_clk}] -min [get_ports {m_axi_awaddr_o* m_axi_awprot_o* m_axi_awvalid_o* s_axi_awready_o m_axi_wdata_o* m_axi_wstrb_o* m_axi_wvalid_o* s_axi_wready_o s_axi_bresp_o* s_axi_bvalid_o m_axi_bready_o* m_axi_araddr_o* m_axi_arprot_o* m_axi_arvalid_o* s_axi_arready_o s_axi_rdata_o* s_axi_rresp_o* s_axi_rvalid_o m_axi_rready_o*}]
