# Internal component estimate; no clock-group cuts or board claim.
create_clock -name core_clk -period 8.000 [get_ports {clk_i}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_display.u_raw.record_sync1 u_display.u_raw.done_sync1* u_display.u_raw.commit_ack_sync1 u_display.u_raw.release_ack_sync1 u_display.u_raw.fault_sync1}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_display.u_raw.request_sync1* u_display.u_raw.commit_sync1 u_display.u_raw.release_sync1 u_display.u_raw.scan_sync1 u_display.u_raw.underflow_sync1}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.mailbox_base* u_display.u_raw.mailbox_stride* u_display.u_raw.mailbox_frame* u_display.u_raw.mailbox_slot*}] -to [get_cells {u_display.u_raw.pending_base* u_display.u_raw.pending_stride* u_display.u_raw.pending_frame* u_display.u_raw.pending_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.req_base*}] -to [get_cells {u_display.u_raw.dma_base_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.req_stride*}] -to [get_cells {u_display.u_raw.dma_stride_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.req_row*}] -to [get_cells {u_display.u_raw.dma_row_latched*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.bank_success*}] -to [get_cells {u_display.u_raw.bank_ready*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.active_frame* u_display.u_raw.active_slot*}] -to [get_cells {u_display.u_raw.commit_frame_id* u_display.u_raw.commit_slot*}]
set_max_delay 6.0 -datapath_only -from [get_cells {u_display.u_raw.release_pixel_id* u_display.u_raw.release_pixel_slot*}] -to [get_cells {u_display.u_raw.release_frame_id* u_display.u_raw.release_slot*}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_display.u_renderer.u_pixels.u_context.request_meta u_display.u_renderer.u_pixels.core_fault_meta u_display.u_renderer.u_asset.u_cache.ready_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_display.u_renderer.u_pixels.u_context.ack_meta u_display.u_renderer.u_pixels.u_context.error_meta u_display.u_renderer.u_pixels.fault_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_display.u_renderer.u_pixels.u_context.mailbox_payload*}] -to [get_cells {u_display.u_renderer.u_pixels.u_context.pixel_payload*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_display.u_renderer.u_asset.u_cache.asset_id* u_display.u_renderer.u_asset.u_cache.asset_generation*}] -to [get_cells {u_display.u_renderer.u_asset.u_cache.pixel_asset_id* u_display.u_renderer.u_asset.u_cache.pixel_generation* u_display.u_renderer.pixel_id* u_display.u_renderer.pixel_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_display.u_raw.mailbox_generation*}] -to [get_cells {u_display.u_raw.pending_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_display.u_raw.active_generation*}] -to [get_cells {u_display.u_raw.commit_generation*}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_display.u_raw.release_pixel_generation*}] -to [get_cells {u_display.u_raw.release_generation*}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {rst_ni online display_urgent source_fault overflow src_valid src_data* c_s_axi_awaddr_i* c_s_axi_awprot_i* c_s_axi_awvalid_i c_s_axi_wdata_i* c_s_axi_wstrb_i* c_s_axi_wvalid_i c_s_axi_bready_i c_s_axi_araddr_i* c_s_axi_arprot_i* c_s_axi_arvalid_i c_s_axi_rready_i d_s_axi_awaddr_i* d_s_axi_awprot_i* d_s_axi_awvalid_i d_s_axi_wdata_i* d_s_axi_wstrb_i* d_s_axi_wvalid_i d_s_axi_bready_i d_s_axi_araddr_i* d_s_axi_arprot_i* d_s_axi_arvalid_i d_s_axi_rready_i h_awready h_arready h_wready h_rvalid h_rdata* h_wid* h_rid* h_wlast h_rlast load_valid load_base* load_bytes* load_asset_id* load_generation* expected_crc* result_ready asset_retire_ready}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {rst_ni online display_urgent source_fault overflow src_valid src_data* c_s_axi_awaddr_i* c_s_axi_awprot_i* c_s_axi_awvalid_i c_s_axi_wdata_i* c_s_axi_wstrb_i* c_s_axi_wvalid_i c_s_axi_bready_i c_s_axi_araddr_i* c_s_axi_arprot_i* c_s_axi_arvalid_i c_s_axi_rready_i d_s_axi_awaddr_i* d_s_axi_awprot_i* d_s_axi_awvalid_i d_s_axi_wdata_i* d_s_axi_wstrb_i* d_s_axi_wvalid_i d_s_axi_bready_i d_s_axi_araddr_i* d_s_axi_arprot_i* d_s_axi_arvalid_i d_s_axi_rready_i h_awready h_arready h_wready h_rvalid h_rdata* h_wid* h_rid* h_wlast h_rlast load_valid load_base* load_bytes* load_asset_id* load_generation* expected_crc* result_ready asset_retire_ready}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {src_ready arm_toggle cancel capture_busy capture_port_drained c_s_axi_awready_o c_s_axi_wready_o c_s_axi_bresp_o* c_s_axi_bvalid_o c_s_axi_arready_o c_s_axi_rdata_o* c_s_axi_rresp_o* c_s_axi_rvalid_o d_s_axi_awready_o d_s_axi_wready_o d_s_axi_bresp_o* d_s_axi_bvalid_o d_s_axi_arready_o d_s_axi_rdata_o* d_s_axi_rresp_o* d_s_axi_rvalid_o irq_capture irq_display faults* capture_code* display_code* memory_code* raw_commits* raw_scans* underflows* read_grants* write_grants* h_awaddr* h_araddr* h_awlen* h_arlen* h_awid* h_arid* h_awvalid h_arvalid h_wdata* h_wstrb* load_ready result_valid result_success result_code* result_asset_id* result_generation* checked_bytes* crc* asset_ready asset_id* asset_generation* words_written* render_faults* read_code* material_code* pixels_code* port_drained raw_grants* asset_grants* asset_retire_valid asset_retire_slot* asset_retire_frame* asset_retire_generation* asset_retire_seq* asset_retire_id* asset_retire_generation_id* owner_error link_error raw_error link_code* raw_code*}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {src_ready arm_toggle cancel capture_busy capture_port_drained c_s_axi_awready_o c_s_axi_wready_o c_s_axi_bresp_o* c_s_axi_bvalid_o c_s_axi_arready_o c_s_axi_rdata_o* c_s_axi_rresp_o* c_s_axi_rvalid_o d_s_axi_awready_o d_s_axi_wready_o d_s_axi_bresp_o* d_s_axi_bvalid_o d_s_axi_arready_o d_s_axi_rdata_o* d_s_axi_rresp_o* d_s_axi_rvalid_o irq_capture irq_display faults* capture_code* display_code* memory_code* raw_commits* raw_scans* underflows* read_grants* write_grants* h_awaddr* h_araddr* h_awlen* h_arlen* h_awid* h_arid* h_awvalid h_arvalid h_wdata* h_wstrb* load_ready result_valid result_success result_code* result_asset_id* result_generation* checked_bytes* crc* asset_ready asset_id* asset_generation* words_written* render_faults* read_code* material_code* pixels_code* port_drained raw_grants* asset_grants* asset_retire_valid asset_retire_slot* asset_retire_frame* asset_retire_generation* asset_retire_seq* asset_retire_id* asset_retire_generation_id* owner_error link_error raw_error link_code* raw_code*}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_reset_n pixel_x* pixel_y* pixel_de pixel_hs pixel_vs pixel_frame_start}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_reset_n pixel_x* pixel_y* pixel_de pixel_hs pixel_vs pixel_frame_start}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {out_rgb* out_de out_hs out_vs raw_frame* pixel_material_ready raw_context_valid raw_slot* raw_generation* raw_x* raw_y* raw_rgb* raw_de raw_hs raw_vs raw_sof out_x* out_y* out_frame* out_generation* out_seq* out_slot* out_mode* out_sof out_box out_point out_avatar out_fault pixel_pending pending_mode* pending_slot* pending_frame* pending_generation*}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {out_rgb* out_de out_hs out_vs raw_frame* pixel_material_ready raw_context_valid raw_slot* raw_generation* raw_x* raw_y* raw_rgb* raw_de raw_hs raw_vs raw_sof out_x* out_y* out_frame* out_generation* out_seq* out_slot* out_mode* out_sof out_box out_point out_avatar out_fault pixel_pending pending_mode* pending_slot* pending_frame* pending_generation*}]
