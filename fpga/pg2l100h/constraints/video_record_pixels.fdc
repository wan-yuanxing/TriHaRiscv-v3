# Component register boundaries only; no external I/O or physical CDC signoff.
create_clock -name core_clk -period 8.000 [get_ports {core_clk}]
create_clock -name pixel_clk -period 25.000 [get_ports {pixel_clk}]
set_false_path -from [get_clocks {core_clk}] -to [get_cells {u_context.request_meta core_fault_meta}]
set_false_path -from [get_clocks {pixel_clk}] -to [get_cells {u_context.ack_meta u_context.error_meta fault_meta}]
set_max_delay 6.000 -datapath_only -from [get_cells {u_context.mailbox_payload*}] -to [get_cells {u_context.pixel_payload*}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {core_reset_n cmd_valid cmd_mode* cmd_slot* cmd_frame* cmd_generation* cmd_seq* cmd_data* commit_ready retire_ready}]
set_input_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {core_reset_n cmd_valid cmd_mode* cmd_slot* cmd_frame* cmd_generation* cmd_seq* cmd_data* commit_ready retire_ready}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -max [get_ports {cmd_ready commit_valid commit_mode* commit_slot* commit_frame* commit_generation* commit_seq* retire_valid retire_slot* retire_mode* retire_frame* retire_generation* retire_seq* retire_raw retire_asset retire_asset_id* retire_asset_generation* fault fault_code*}]
set_output_delay 0.000 -clock [get_clocks {core_clk}] -min [get_ports {cmd_ready commit_valid commit_mode* commit_slot* commit_frame* commit_generation* commit_seq* retire_valid retire_slot* retire_mode* retire_frame* retire_generation* retire_seq* retire_raw retire_asset retire_asset_id* retire_asset_generation* fault fault_code*}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {pixel_reset_n raw_* asset_* sample_*}]
set_input_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {pixel_reset_n raw_* asset_* sample_*}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -max [get_ports {avatar_req_* out_* pixel_pending pending_*}]
set_output_delay 0.000 -clock [get_clocks {pixel_clk}] -min [get_ports {avatar_req_* out_* pixel_pending pending_*}]
