      "severity": "important",
      "file": "tb/video/test_video_pipeline.c",
      "line": 64,
      "title": "Third-slot premature-present assertion expects STATE while a prior submission is pending",
      "description": "On iteration 2, the second display submission intentionally remains unacknowledged. video_frame_pool_present checks p.pending.valid before slot state and returns VIDEO_FRAME_BUSY. The unconditional STATE expectation aborts before third-slot capture and slot0 reuse.",
      "evidence": "Actual normal run failed at VIDEO_PIPELINE_C_ASSERT NO_PRESENT_BEFORE_CAPTURE; normal RPC ends after the second submission returns real events 3.",
      "recommendation": "Keep frozen C driver. Assert BUSY when the prior submission remains pending and STATE when there is no pending submission, while checking no I/O or pool mutation.",
      "status": "closed",
      "closure_evidence": "Full normal actual C/RTL PASS; corrected BUSY precedence with NO_IO checks."
    },
    {
      "id": "R2",
      "priority": 2,
      "severity": "important",
      "file": "tb/video/models/video_pipeline_memory.sv",
      "line": 98,
      "title": "Byte totals do not prove every expected address was written",
      "description": "The memory model validates only presented address/data pairs and increments totals even for duplicate addresses. V uses only totals. Correct repeated writes can leave preview/input locations at initialized A5; display raster checks only RAW.",
      "evidence": "Independent H10 model probe repeats the first valid 32B of each branch until all expected totals are reached: raw24000 preview6000 input80640; all branch offset32 locations remain A5, and the oracle accepts every write.",
      "recommendation": "Track address coverage per frame/slot, reject duplicate effective byte writes, and require complete branch coverage at V. A final full-span data check is another option.",
      "probe_result": "build/video/pipeline_review/20261021T020532Z/probe_result.json",
      "status": "closed",
      "closure_evidence": "Original independent duplicate-address probe now exits nonzero at PIPELINE_DUPLICATE_WRITE; full three-branch normal scenario PASS."
    }
