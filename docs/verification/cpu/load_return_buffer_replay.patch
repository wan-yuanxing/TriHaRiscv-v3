diff --git a/rtl/cpu/triha_load_buffer.v b/rtl/cpu/triha_load_buffer.v
new file mode 100644
--- /dev/null
+++ b/rtl/cpu/triha_load_buffer.v
@@ -0,0 +1,62 @@
+/* TriHa32-entry local SRAM completed-load forwarding buffer.
+ * Native RAM/tag/valid storage follows the existing CPU storage pattern.
+ * This module never acknowledges or suppresses a real memory transaction.
+ */
+module triha_load_buffer #(
+    parameter [31:0] SRAM_BASE = 32'h00010000
+) (
+    input wire clk_i,
+    input wire rst_i,
+    input wire invalidate_i,
+    input wire [31:0] lookup_addr_i,
+    output reg hit_o,
+    output reg [31:0] data_o,
+    input wire fill_i,
+    input wire [31:0] fill_addr_i,
+    input wire [31:0] fill_data_i,
+    input wire store_i,
+    input wire [31:0] store_addr_i
+);
+    reg [31:0] valid_q;
+    wire lookup_local_w = lookup_addr_i[31:15] == SRAM_BASE[31:15];
+    wire fill_local_w = fill_addr_i[31:15] == SRAM_BASE[31:15];
+    wire store_local_w = store_addr_i[31:15] == SRAM_BASE[31:15];
+    wire [39:0] write_data_w = {fill_addr_i[14:7],fill_data_i};
+    wire [39:0] read_data_w;
+    wire write_w = fill_i && fill_local_w && !rst_i && !invalidate_i;
+    integer entry;
+    always @(posedge clk_i or posedge rst_i)
+    if (rst_i)
+        valid_q <= 32'b0;
+    else if (invalidate_i)
+        valid_q <= 32'b0;
+    else begin
+        for (entry=0;entry<32;entry=entry+1) begin
+            if (store_i && store_local_w && store_addr_i[6:2] == entry)
+                valid_q[entry] <= 1'b0;
+            else if (write_w && fill_addr_i[6:2] == entry)
+                valid_q[entry] <= 1'b1;
+        end
+    end
+    genvar pair;
+    generate for (pair=0;pair<20;pair=pair+1) begin: g_word
+        GTP_RAM32X2DP #(.INIT_0(32'b0),.INIT_1(32'b0)) u_ram (
+            .DO(read_data_w[pair*2 +: 2]),.DI(write_data_w[pair*2 +: 2]),
+            .RADDR(lookup_addr_i[6:2]),.WADDR(fill_addr_i[6:2]),
+            .WCLK(clk_i),.WE(write_w)
+        );
+    end endgenerate
+    always @* begin
+        hit_o = 1'b0;
+        data_o = 32'b0;
+        if (!rst_i && !invalidate_i && lookup_local_w &&
+            valid_q[lookup_addr_i[6:2]] && read_data_w[39:32] == lookup_addr_i[14:7]) begin
+            hit_o = 1'b1;
+            data_o = read_data_w[31:0];
+        end
+    end
+    // synthesis translate_off
+    initial if (SRAM_BASE[14:0] != 0)
+        $fatal(1,"LOAD_RETURN_BUFFER_FAIL base_must_align32KiB");
+    // synthesis translate_on
+endmodule
diff --git a/tb/cpu/tb_load_return_buffer.v b/tb/cpu/tb_load_return_buffer.v
new file mode 100644
--- /dev/null
+++ b/tb/cpu/tb_load_return_buffer.v
@@ -0,0 +1,83 @@
+`timescale 1ns/1ps
+// Independent word-index/tag oracle; no CPU or production decode reused.
+module tb_load_return_buffer #(parameter BROKEN=0);
+    reg clk=0,rst=1,invalidate=0,fill=0,store=0;
+    reg [31:0] query=0,fill_addr=0,fill_data=0,store_addr=0,rng=32'h37c4a2e1;
+    reg [31:0] words[0:31];
+    reg [31:0] addresses[0:31];
+    reg valid[0:31];
+    wire hit;
+    wire [31:0] data;
+    integer n,k,checks=0;
+    reg expected_hit;
+    reg [31:0] expected_data;
+    always #5 clk=~clk;
+    triha_load_buffer u_dut (
+        .clk_i(clk),.rst_i(rst),.invalidate_i(invalidate),
+        .lookup_addr_i(query),.hit_o(hit),.data_o(data),
+        .fill_i(fill),.fill_addr_i(fill_addr),.fill_data_i(fill_data),
+        .store_i(store),.store_addr_i(store_addr)
+    );
+    task check;
+        begin
+            expected_hit=0;expected_data=0;
+            for(k=0;k<32;k=k+1)
+                if(valid[k] && query>=32'h10000 && query<32'h18000 &&
+                   (query>>2)==(addresses[k]>>2) && !invalidate && !rst) begin
+                    expected_hit=1;expected_data=words[k];
+                end
+            if({hit,data}!=={expected_hit,expected_data})
+                $fatal(1,"LOAD_RETURN_BUFFER_FAIL check=%0d query=%h hit=%b expected=%b data=%h expected_data=%h",checks,query,hit,expected_hit,data,expected_data);
+        end
+    endtask
+    task step;
+        begin
+            #1;check;
+            @(posedge clk);
+            if(rst || invalidate) begin
+                for(k=0;k<32;k=k+1)valid[k]=0;
+            end else begin
+                if(fill && fill_addr>=32'h10000 && fill_addr<32'h18000) begin
+                    valid[(fill_addr/4)%32]=1;
+                    words[(fill_addr/4)%32]=fill_data;
+                    addresses[(fill_addr/4)%32]=fill_addr;
+                end
+                // Store index wins even if its tag differs or fill collides.
+                if(store && store_addr>=32'h10000 && store_addr<32'h18000)
+                    valid[(store_addr/4)%32]=0;
+            end
+            #1;check;checks=checks+1;
+            @(negedge clk);
+        end
+    endtask
+    task random_next;
+        begin rng=rng^(rng<<13);rng=rng^(rng>>17);rng=rng^(rng<<5);end
+    endtask
+    initial begin
+        for(k=0;k<32;k=k+1)begin valid[k]=0;words[k]=0;addresses[k]=0;end
+        step;rst=0;
+        for(n=0;n<32;n=n+1)begin fill=1;fill_addr=32'h10000+n*4;fill_data=32'h87650000+n;query=fill_addr;step;end
+        fill=0;
+        for(n=0;n<128;n=n+1)begin query=32'h10000+n;step;end
+        query=32'h10100;step; // Same index, wrong tag.
+        fill=1;fill_addr=query;fill_data=32'h12345678;step;fill=0;query=32'h10000;step;
+        query=32'h10100;store=1;store_addr=32'h10300;step;store=0;step;
+        fill=1;fill_addr=query;store=1;store_addr=query;step;fill=0;store=0;step;
+        fill=1;fill_addr=query;fill_data=32'hxxzz34ff;step;fill=0;step;
+        if(BROKEN) force u_dut.data_o=32'hdeadbeef;
+        for(n=0;n<20000;n=n+1) begin
+            random_next;fill=rng[0];store=rng[1];invalidate=rng[8:2]==0;rst=(n%997)==0;
+            query=32'h10000+{24'b0,rng[7:0]};
+            random_next;fill_addr=32'h10000+{24'b0,rng[7:0]};fill_data=rng;
+            random_next;store_addr=32'h10000+{24'b0,rng[7:0]};
+            if(n%7==0)query=fill_addr;
+            if(n%11==0)store_addr=fill_addr;
+            if(n%13==0)fill_addr=32'h20000;
+            if(n%17==0)query=32'h18000;
+            if(n%19==0)store_addr=32'h20000;
+            if(n%101==0)query=32'hxxxxxxxx;
+            step;
+        end
+        $display("LOAD_RETURN_BUFFER_PASS checks=%0d alias_range_store_fill_reset_xz",checks);$finish;
+    end
+endmodule
diff --git a/tb/cpu/tb_lsu_early_load.v b/tb/cpu/tb_lsu_early_load.v
new file mode 100644
--- /dev/null
+++ b/tb/cpu/tb_lsu_early_load.v
@@ -0,0 +1,68 @@
+`timescale 1ns/1ps
+module tb_lsu_early_load #(parameter BROKEN=0);
+    reg clk=0,rst=1,valid=0,accept=1,ack=0,error=0;
+    reg [31:0] op=0,ra=0,rb=0,rdata=0;
+    wire [31:0] addr,wdata,early_data,wb_data,bypass_data;
+    wire [3:0] wr;
+    wire rd,early_valid,stall,wb_valid;
+    wire [5:0] exception;
+    integer checks=0;
+    always #5 clk=~clk;
+    triha_lsu #(.EARLY_LOAD_BYPASS(1)) u_dut (
+        .clk_i(clk),.rst_i(rst),.early_invalidate_i(1'b0),.opcode_valid_i(valid),.opcode_opcode_i(op),
+        .opcode_pc_i(32'b0),.opcode_invalid_i(1'b0),.opcode_rd_idx_i(op[11:7]),
+        .opcode_ra_idx_i(op[19:15]),.opcode_rb_idx_i(op[24:20]),
+        .opcode_ra_operand_i(ra),.opcode_rb_operand_i(rb),
+        .mem_data_rd_i(rdata),.mem_accept_i(accept),.mem_ack_i(ack),.mem_error_i(error),
+        .mem_resp_tag_i(11'b0),.mem_load_fault_i(1'b0),.mem_store_fault_i(1'b0),
+        .mem_addr_o(addr),.mem_data_wr_o(wdata),.mem_wr_o(wr),.mem_rd_o(rd),
+        .writeback_valid_o(wb_valid),.writeback_value_o(wb_data),
+        .writeback_bypass_o(bypass_data),.writeback_exception_o(exception),.stall_o(stall),
+        .early_load_value_o(early_data),.early_load_valid_o(early_valid)
+    );
+    task edge_step;begin @(posedge clk);#1;checks=checks+1;@(negedge clk);end endtask
+    task idle;begin valid=0;ack=0;error=0;edge_step;end endtask
+    task issue_load;
+        input [31:0] code,address;input hit;input [31:0] expected;
+        begin
+            valid=1;op=code;ra=address;edge_step;valid=0;
+            if(rd!==1 || addr!==(address&32'hfffffffc) || early_valid!==hit)
+                $fatal(1,"LSU_EARLY_LOAD_FAIL real_request_or_hit addr=%h early=%b expected=%b",addr,early_valid,hit);
+            if(hit && early_data!==expected)$fatal(1,"LSU_EARLY_LOAD_FAIL payload got=%h expected=%h",early_data,expected);
+        end
+    endtask
+    task complete_load;
+        input [31:0] value;input bad;
+        begin
+            edge_step; // Accept request at this edge, request now tracked in E2.
+            ack=1;error=bad;rdata=value;#1;
+            if(!wb_valid || (bad && (wb_data!==32'h10000 || exception!==6'h15)))
+                $fatal(1,"LSU_EARLY_LOAD_FAIL fault_badaddr_or_completion");
+            edge_step;ack=0;error=0;idle;
+        end
+    endtask
+    initial begin
+        edge_step;edge_step;rst=0;idle;
+        issue_load(32'h00002283,32'h10000,0,0);complete_load(32'h817f8001,0);
+        issue_load(32'h00002283,32'h10000,1,32'h817f8001);
+        if(BROKEN)begin force u_dut.early_load_value_o=0;#1;if(early_data!==32'h817f8001)$fatal(1,"LSU_EARLY_LOAD_FAIL corrupt_early_data");end
+        complete_load(32'h817f8001,0);
+        issue_load(32'h00000283,32'h10001,1,32'hffffff80);complete_load(32'h817f8001,0);
+        issue_load(32'h00004283,32'h10003,1,32'h00000081);complete_load(32'h817f8001,0);
+        issue_load(32'h00001283,32'h10002,1,32'hffff817f);complete_load(32'h817f8001,0);
+        issue_load(32'h00005283,32'h10000,1,32'h00008001);complete_load(32'h817f8001,0);
+        // A cached early hit must not hide the real error or its bad address.
+        issue_load(32'h00002283,32'h10000,1,32'h817f8001);complete_load(32'h12345678,1);
+        issue_load(32'h00002283,32'h18000,0,0);complete_load(32'hfeedbeef,0);
+        // Accepted store invalidates; completion must still use original bus.
+        valid=1;op=32'h00502023;ra=32'h10000;rb=32'h99887766;edge_step;valid=0;
+        if(wr!==4'hf || wdata!==rb)$fatal(1,"LSU_EARLY_LOAD_FAIL store_payload");
+        edge_step;ack=1;edge_step;ack=0;idle;
+        issue_load(32'h00002283,32'h10000,0,0);complete_load(32'h99887766,0);
+        // Backpressure must keep the actual request, not replace it by a hit ack.
+        accept=0;issue_load(32'h00002283,32'h10000,1,32'h99887766);
+        repeat(4)begin edge_step;if(!rd || addr!==32'h10000 || !stall)$fatal(1,"LSU_EARLY_LOAD_FAIL held_request");end
+        accept=1;complete_load(32'h99887766,0);
+        $display("LSU_EARLY_LOAD_PASS checks=%0d request_error_format_store_backpressure",checks);$finish;
+    end
+endmodule
diff --git a/tb/cpu/tb_issue_load_forward.v b/tb/cpu/tb_issue_load_forward.v
new file mode 100644
--- /dev/null
+++ b/tb/cpu/tb_issue_load_forward.v
@@ -0,0 +1,69 @@
+/* E1 local load hit/miss forwarding; both word slots and cancellation. */
+`timescale 1ns/1ps
+module tb_issue_load_forward #(parameter BROKEN=0);
+    reg clk=0,rst=1,run_clock=1;
+    reg [31:0] op=32'h00128313;
+    reg [31:0] cached=7;
+    reg available=0;
+    reg [63:0] expected;
+    reg [31:0] rng=32'h271828;
+    integer index,checks=0;
+    always #5 if(run_clock) clk=~clk;
+    triha_cpu #(.EARLY_LOAD_BYPASS(1),.SUPPORT_DUAL_ISSUE(0),.SUPPORT_SUPER(0),.SUPPORT_MMU(0)) u_dut (
+        .clk_i(clk),.rst_i(rst),.intr_i(1'b0),.reset_vector_i(32'h80000000),.cpu_id_i(32'b0),
+        .mem_i_accept_i(1'b1),.mem_i_valid_i(1'b0),.mem_i_error_i(1'b0),.mem_i_inst_i(64'b0),
+        .mem_d_data_rd_i(32'b0),.mem_d_accept_i(1'b1),.mem_d_ack_i(1'b0),
+        .mem_d_error_i(1'b0),.mem_d_resp_tag_i(11'b0));
+    `define I u_dut.u_issue
+    task check;
+        input issued;
+        begin
+            #1;checks=checks+1;
+            if(`I.opcode_a_issue_r!==issued)
+                $fatal(1,"LOAD_FORWARD_FAIL issue expected=%b actual=%b",issued,`I.opcode_a_issue_r);
+            if(issued && `I.opcode0_ra_operand_o!==expected[31:0])
+                $fatal(1,"LOAD_FORWARD_FAIL operand expected=%h actual=%h",expected[31:0],`I.opcode0_ra_operand_o);
+        end
+    endtask
+    initial begin
+        repeat(5) @(negedge clk);rst=0;run_clock=0;
+        force `I.pc_x_q=32'h80000000;
+        force `I.fetch0_valid_i=1;force `I.fetch0_pc_i=32'h80000000;force `I.fetch0_instr_i=op;
+        force `I.fetch0_fault_fetch_i=0;force `I.fetch0_fault_page_i=0;
+        force `I.fetch0_instr_exec_i=1;force `I.fetch0_instr_lsu_i=0;force `I.fetch0_instr_mul_i=0;
+        force `I.fetch0_instr_div_i=0;force `I.fetch0_instr_csr_i=0;force `I.fetch0_instr_invalid_i=0;
+        force `I.fetch0_instr_rd_valid_i=1;force `I.fetch1_valid_i=0;
+        force `I.branch_csr_request_i=0;force `I.squash_w=0;force `I.take_interrupt_i=0;
+        force `I.lsu_stall_i=0;force `I.stall_w=0;force `I.div_pending_q=0;force `I.csr_pending_q=0;
+        force `I.pipe0_mul_e1_w=0;force `I.pipe0_load_e1_w=1;force `I.pipe0_store_e1_w=0;
+        force `I.pipe1_mul_e1_w=0;force `I.pipe1_load_e1_w=0;force `I.pipe1_store_e1_w=0;
+        force `I.pipe0_rd_e1_w=5;force `I.pipe1_rd_e1_w=0;
+        force `I.pipe0_opcode_e1_w=32'h00002283; // LW x5,0(x0)
+        force `I.pipe0_rd_bypass_e2_w=0;force `I.pipe0_rd_bypass_wb_w=0;
+        force `I.pipe1_rd_bypass_e2_w=0;force `I.pipe1_rd_bypass_wb_w=0;
+        force u_dut.u_lsu.early_load_value_o=cached;
+        force u_dut.u_lsu.early_load_valid_o=available;
+        if(BROKEN) force u_dut.u_lsu.early_load_value_o=0;
+        for(index=0;index<1024;index=index+1) begin
+            rng={rng[30:0],rng[31]^rng[21]^rng[1]^rng[0]};
+            cached=rng;expected=rng;available=index[0];check(available);
+        end
+        available=1;cached=32'h81234567;expected=cached;
+        op=32'h00528333;check(1);
+        if(`I.opcode0_rb_operand_o!==cached)$fatal(1,"LOAD_FORWARD_FAIL source2");
+        force `I.pc_x_q=32'h80000004;
+        force `I.fetch0_valid_i=0;force `I.fetch1_valid_i=1;
+        force `I.fetch1_pc_i=32'h80000004;force `I.fetch1_instr_i=op;
+        force `I.fetch1_fault_fetch_i=0;force `I.fetch1_fault_page_i=0;
+        force `I.fetch1_instr_exec_i=1;force `I.fetch1_instr_lsu_i=0;force `I.fetch1_instr_mul_i=0;
+        force `I.fetch1_instr_div_i=0;force `I.fetch1_instr_csr_i=0;force `I.fetch1_instr_invalid_i=0;
+        force `I.fetch1_instr_rd_valid_i=1;check(1);
+        if(`I.opcode0_rb_operand_o!==cached)$fatal(1,"LOAD_FORWARD_FAIL upper_source2");
