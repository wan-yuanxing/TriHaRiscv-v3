+
+// Completed local SRAM words may feed an E1 dependent instruction, but
+// every load still uses the unchanged real request, E2 completion and error.
+generate if (EARLY_LOAD_BYPASS) begin: g_early_load
+    wire [31:0] cached_word_w;
+    wire hit_w;
+    wire invalidate_w = early_invalidate_i || mem_flush_q ||
+        mem_writeback_q || mem_invalidate_q || (mem_ack_i && mem_error_i);
+    triha_load_buffer #(.SRAM_BASE(LOAD_BUFFER_BASE)) u_buffer (
+        .clk_i(clk_i),.rst_i(rst_i),.invalidate_i(invalidate_w),
+        .lookup_addr_i(mem_addr_q),.hit_o(hit_w),.data_o(cached_word_w),
+        .fill_i(pending_lsu_e2_q && mem_ack_i && !mem_error_i && resp_load_w && !mem_unaligned_e2_q),
+        .fill_addr_i(resp_addr_w),.fill_data_i(mem_data_rd_i),
+        .store_i(issue_lsu_e1_w && (|mem_wr_o)),.store_addr_i(mem_addr_q)
+    );
+    reg [31:0] value_r;
+    always @* begin
+        value_r = 32'b0;
+        if (mem_xb_q) begin
+            case (mem_addr_q[1:0])
+                2'd0: value_r = {24'b0,cached_word_w[7:0]};
+                2'd1: value_r = {24'b0,cached_word_w[15:8]};
+                2'd2: value_r = {24'b0,cached_word_w[23:16]};
+                2'd3: value_r = {24'b0,cached_word_w[31:24]};
+            endcase
+            if (mem_ls_q && value_r[7]) value_r = {24'hffffff,value_r[7:0]};
+        end else if (mem_xh_q) begin
+            if (mem_addr_q[1]) value_r = {16'b0,cached_word_w[31:16]};
+            else value_r = {16'b0,cached_word_w[15:0]};
+            if (mem_ls_q && value_r[15]) value_r = {16'hffff,value_r[15:0]};
+        end else value_r = cached_word_w;
+    end
+    assign early_load_value_o = value_r;
+    assign early_load_valid_o = hit_w && mem_rd_q && mem_load_q && !mem_unaligned_e1_q;
+end else begin: g_no_early_load
+    assign early_load_value_o = 32'b0;
+    assign early_load_valid_o = 1'b0;
+end endgenerate
 
 triha_lsu_fifo
