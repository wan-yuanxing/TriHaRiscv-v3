-module triha_lsu_fifo
-//-----------------------------------------------------------------
-// Params
-//-----------------------------------------------------------------
-#(
-    parameter WIDTH   = 8,
-    parameter DEPTH   = 4,
-    parameter ADDR_W  = 2
-)
-//-----------------------------------------------------------------
-// Ports
-//-----------------------------------------------------------------
-(
-    // Inputs
-     input               clk_i
-    ,input               rst_i
-    ,input  [WIDTH-1:0]  data_in_i
-    ,input               push_i
-    ,input               pop_i
-
-    // Outputs
-    ,output [WIDTH-1:0]  data_out_o
-    ,output              accept_o
-    ,output              valid_o
-);
-
-generate
-if (DEPTH == 2 && ADDR_W == 1) begin: g_head
-    // Same circular storage in read-relative coordinates:
-    // head = ram[rd_ptr], tail = ram[~rd_ptr]. On a pop the banks rotate.
-    // Retaining the old head as tail also preserves data_out while empty.
-    reg [WIDTH-1:0] head_q;
-    reg [WIDTH-1:0] tail_q;
-    reg [1:0] count_q;
-    wire push_w = push_i && accept_o;
-    wire pop_w = pop_i && valid_o;
-
-    assign valid_o = count_q != 2'd0;
-    assign accept_o = count_q != 2'd2;
-    assign data_out_o = head_q;
-
-    always @(posedge clk_i or posedge rst_i)
-    if (rst_i) begin
-        head_q <= {WIDTH{1'b0}};
-        tail_q <= {WIDTH{1'b0}};
-        count_q <= 2'd0;
-    end else begin
-        case ({pop_w,push_w})
-            2'b01: begin
-                if (count_q == 2'd0)
-                    head_q <= data_in_i;
-                else
-                    tail_q <= data_in_i;
-            end
-            2'b10: begin
-                head_q <= tail_q;
-                tail_q <= head_q;
-            end
-            2'b11: begin
-                // Only count=1 can accept both: replace the next head.
-                head_q <= data_in_i;
-                tail_q <= head_q;
-            end
-            default: ;
-        endcase
-        if (push_w && !pop_w)
-            count_q <= count_q + 2'd1;
-        else if (!push_w && pop_w)
-            count_q <= count_q - 2'd1;
-    end
-end else begin: g_ring
-
-//-----------------------------------------------------------------
-// Local Params
-//-----------------------------------------------------------------
-localparam COUNT_W = ADDR_W + 1;
-
-//-----------------------------------------------------------------
-// Registers
-//-----------------------------------------------------------------
-reg [WIDTH-1:0]   ram_q[DEPTH-1:0];
-reg [ADDR_W-1:0]  rd_ptr_q;
-reg [ADDR_W-1:0]  wr_ptr_q;
-reg [COUNT_W-1:0] count_q;
-
-integer i;
-
-//-----------------------------------------------------------------
-// Sequential
-//-----------------------------------------------------------------
-always @ (posedge clk_i or posedge rst_i)
-if (rst_i)
-begin
-    count_q   <= {(COUNT_W) {1'b0}};
-    rd_ptr_q  <= {(ADDR_W) {1'b0}};
-    wr_ptr_q  <= {(ADDR_W) {1'b0}};
-
-    for (i=0;i<DEPTH;i=i+1)
-    begin
-        ram_q[i] <= {(WIDTH) {1'b0}};
-    end
-end
-else
-begin
-    // Push
-    if (push_i & accept_o)
-    begin
-        ram_q[wr_ptr_q] <= data_in_i;
-        wr_ptr_q        <= wr_ptr_q + 1;
-    end
-
-    // Pop
-    if (pop_i & valid_o)
-        rd_ptr_q      <= rd_ptr_q + 1;
-
-    // Count up
-    if ((push_i & accept_o) & ~(pop_i & valid_o))
-        count_q <= count_q + 1;
-    // Count down
-    else if (~(push_i & accept_o) & (pop_i & valid_o))
-        count_q <= count_q - 1;
-end
-
-//-------------------------------------------------------------------
-// Combinatorial
-//-------------------------------------------------------------------
-/* verilator lint_off WIDTH */
-assign valid_o       = (count_q != 0);
-assign accept_o      = (count_q != DEPTH);
-/* verilator lint_on WIDTH */
-
-assign data_out_o    = ram_q[rd_ptr_q];
-
-end
-endgenerate
-
-endmodule
