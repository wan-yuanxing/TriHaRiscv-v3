-            {pipe0_rd_bypass_e2_w,pipe0_rd_bypass_wb_w,pipe1_rd_bypass_e2_w,pipe1_rd_bypass_wb_w})
-            $fatal(1,"BYPASS_TAG_FAIL actual_issue_tag_mismatch");
-    end
-end
