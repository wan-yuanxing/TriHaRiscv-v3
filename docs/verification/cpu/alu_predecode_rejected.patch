+
+// Exact ALU mask priority, evaluated before the existing fetch FIFO.
+// control_o = {ALU function[3:0], A source[1:0], B source[2:0]}.
+// A:0=zero,1=RA,2=U-immediate,3=PC. B:0=zero,1=RB,2=I-immediate,
+// 3=shift amount,4=U-immediate,5=constant4. Zero opcode decodes to zero.
+module triha_alu_decode (
+    input wire [31:0] opcode_i,
+    output wire [8:0] control_o
+);
+`include "biriscv_defs.v"
+reg [3:0]  alu_func_r;
+reg [1:0] source_a_r;
+reg [2:0] source_b_r;
+
+always @ *
+begin
+    alu_func_r     = `ALU_NONE;
+    source_a_r = 2'd0;
+    source_b_r = 3'd0;
+
+    if ((opcode_i & `INST_ADD_MASK) == `INST_ADD) // add
+    begin
+        alu_func_r     = `ALU_ADD;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_AND_MASK) == `INST_AND) // and
+    begin
+        alu_func_r     = `ALU_AND;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_OR_MASK) == `INST_OR) // or
+    begin
+        alu_func_r     = `ALU_OR;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_SLL_MASK) == `INST_SLL) // sll
+    begin
+        alu_func_r     = `ALU_SHIFTL;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_SRA_MASK) == `INST_SRA) // sra
+    begin
+        alu_func_r     = `ALU_SHIFTR_ARITH;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_SRL_MASK) == `INST_SRL) // srl
+    begin
+        alu_func_r     = `ALU_SHIFTR;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_SUB_MASK) == `INST_SUB) // sub
+    begin
+        alu_func_r     = `ALU_SUB;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_XOR_MASK) == `INST_XOR) // xor
+    begin
+        alu_func_r     = `ALU_XOR;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_SLT_MASK) == `INST_SLT) // slt
+    begin
+        alu_func_r     = `ALU_LESS_THAN_SIGNED;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_SLTU_MASK) == `INST_SLTU) // sltu
+    begin
+        alu_func_r     = `ALU_LESS_THAN;
+        source_a_r = 2'd1;
+        source_b_r = 3'd1;
+    end
+    else if ((opcode_i & `INST_ADDI_MASK) == `INST_ADDI) // addi
+    begin
+        alu_func_r     = `ALU_ADD;
+        source_a_r = 2'd1;
+        source_b_r = 3'd2;
+    end
+    else if ((opcode_i & `INST_ANDI_MASK) == `INST_ANDI) // andi
+    begin
+        alu_func_r     = `ALU_AND;
+        source_a_r = 2'd1;
+        source_b_r = 3'd2;
+    end
+    else if ((opcode_i & `INST_SLTI_MASK) == `INST_SLTI) // slti
+    begin
+        alu_func_r     = `ALU_LESS_THAN_SIGNED;
+        source_a_r = 2'd1;
+        source_b_r = 3'd2;
+    end
+    else if ((opcode_i & `INST_SLTIU_MASK) == `INST_SLTIU) // sltiu
+    begin
+        alu_func_r     = `ALU_LESS_THAN;
+        source_a_r = 2'd1;
+        source_b_r = 3'd2;
+    end
+    else if ((opcode_i & `INST_ORI_MASK) == `INST_ORI) // ori
+    begin
+        alu_func_r     = `ALU_OR;
+        source_a_r = 2'd1;
+        source_b_r = 3'd2;
+    end
+    else if ((opcode_i & `INST_XORI_MASK) == `INST_XORI) // xori
+    begin
+        alu_func_r     = `ALU_XOR;
+        source_a_r = 2'd1;
+        source_b_r = 3'd2;
+    end
+    else if ((opcode_i & `INST_SLLI_MASK) == `INST_SLLI) // slli
+    begin
+        alu_func_r     = `ALU_SHIFTL;
+        source_a_r = 2'd1;
+        source_b_r = 3'd3;
+    end
+    else if ((opcode_i & `INST_SRLI_MASK) == `INST_SRLI) // srli
+    begin
+        alu_func_r     = `ALU_SHIFTR;
+        source_a_r = 2'd1;
+        source_b_r = 3'd3;
+    end
+    else if ((opcode_i & `INST_SRAI_MASK) == `INST_SRAI) // srai
+    begin
+        alu_func_r     = `ALU_SHIFTR_ARITH;
+        source_a_r = 2'd1;
+        source_b_r = 3'd3;
+    end
+    else if ((opcode_i & `INST_LUI_MASK) == `INST_LUI) // lui
+    begin
+        source_a_r = 2'd2;
+    end
+    else if ((opcode_i & `INST_AUIPC_MASK) == `INST_AUIPC) // auipc
+    begin
+        alu_func_r     = `ALU_ADD;
+        source_a_r = 2'd3;
+        source_b_r = 3'd4;
+    end     
+    else if (((opcode_i & `INST_JAL_MASK) == `INST_JAL) || ((opcode_i & `INST_JALR_MASK) == `INST_JALR)) // jal, jalr
+    begin
+        alu_func_r     = `ALU_ADD;
+        source_a_r = 2'd3;
+        source_b_r = 3'd5;
+    end
+end
+
+
+assign control_o = {alu_func_r,source_a_r,source_b_r};
+endmodule
diff --git a/rtl/cpu/triha_exec.v b/rtl/cpu/triha_exec.v
new file mode 100644
--- /dev/null
+++ b/rtl/cpu/triha_exec.v
@@ -0,0 +1,285 @@
+//-----------------------------------------------------------------
+//                         biRISC-V CPU
+//                            V0.8.1
+//                     Ultra-Embedded.com
+//                     Copyright 2019-2020
+//
+//                   admin@ultra-embedded.com
+//
+//                     License: Apache 2.0
+//-----------------------------------------------------------------
+// Copyright 2020 Ultra-Embedded.com
+// 
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+// 
+//     http://www.apache.org/licenses/LICENSE-2.0
+// 
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//-----------------------------------------------------------------
+
+// TriHa maintained execution derivative; see ADAPTATIONS.json.
+module triha_exec
+(
+    // Inputs
+     input           clk_i
+    ,input           rst_i
+    ,input           opcode_valid_i
+    ,input  [  8:0]  opcode_alu_i
+    ,input  [ 31:0]  opcode_opcode_i
+    ,input  [ 31:0]  opcode_pc_i
+    ,input           opcode_invalid_i
+    ,input  [  4:0]  opcode_rd_idx_i
+    ,input  [  4:0]  opcode_ra_idx_i
+    ,input  [  4:0]  opcode_rb_idx_i
+    ,input  [ 31:0]  opcode_ra_operand_i
+    ,input  [ 31:0]  opcode_rb_operand_i
+    ,input           hold_i
+
+    // Outputs
+    ,output          branch_request_o
+    ,output          branch_is_taken_o
+    ,output          branch_is_not_taken_o
+    ,output [ 31:0]  branch_source_o
+    ,output          branch_is_call_o
+    ,output          branch_is_ret_o
+    ,output          branch_is_jmp_o
+    ,output [ 31:0]  branch_pc_o
+    ,output          branch_d_request_o
+    ,output [ 31:0]  branch_d_pc_o
+    ,output [  1:0]  branch_d_priv_o
+    ,output [ 31:0]  writeback_value_o
+);
+
+
+
+//-----------------------------------------------------------------
+// Includes
+//-----------------------------------------------------------------
+`include "biriscv_defs.v"
+
+//-------------------------------------------------------------
+// Opcode decode
+//-------------------------------------------------------------
+reg [31:0]  imm20_r;
+reg [31:0]  imm12_r;
+reg [31:0]  bimm_r;
+reg [31:0]  jimm20_r;
+reg [4:0]   shamt_r;
+
+always @ *
+begin
+    imm20_r     = {opcode_opcode_i[31:12], 12'b0};
+    imm12_r     = {{20{opcode_opcode_i[31]}}, opcode_opcode_i[31:20]};
+    bimm_r      = {{19{opcode_opcode_i[31]}}, opcode_opcode_i[31], opcode_opcode_i[7], opcode_opcode_i[30:25], opcode_opcode_i[11:8], 1'b0};
+    jimm20_r    = {{12{opcode_opcode_i[31]}}, opcode_opcode_i[19:12], opcode_opcode_i[20], opcode_opcode_i[30:25], opcode_opcode_i[24:21], 1'b0};
+    shamt_r     = opcode_opcode_i[24:20];
+end
+
+//-------------------------------------------------------------
+// Execute - ALU operations
+//-------------------------------------------------------------
+wire [3:0] alu_func_r = opcode_alu_i[8:5];
+reg [31:0] alu_input_a_r;
+reg [31:0] alu_input_b_r;
+// Case selection preserves selected X/Z payload bits, including LUI data.
+always @* begin
+    case (opcode_alu_i[4:3])
+        2'd1: alu_input_a_r = opcode_ra_operand_i;
+        2'd2: alu_input_a_r = imm20_r;
+        2'd3: alu_input_a_r = opcode_pc_i;
+        default: alu_input_a_r = 32'b0;
+    endcase
+    case (opcode_alu_i[2:0])
+        3'd1: alu_input_b_r = opcode_rb_operand_i;
+        3'd2: alu_input_b_r = imm12_r;
+        3'd3: alu_input_b_r = {27'b0,shamt_r};
+        3'd4: alu_input_b_r = imm20_r;
+        3'd5: alu_input_b_r = 32'd4;
+        default: alu_input_b_r = 32'b0;
+    endcase
+end
+
+//-------------------------------------------------------------
+// ALU
+//-------------------------------------------------------------
+wire [31:0]  alu_p_w;
+biriscv_alu
+u_alu
+(
+    .alu_op_i(alu_func_r),
+    .alu_a_i(alu_input_a_r),
+    .alu_b_i(alu_input_b_r),
+    .alu_p_o(alu_p_w)
+);
+
+//-------------------------------------------------------------
+// Flop ALU output
+//-------------------------------------------------------------
+reg [31:0] result_q;
+always @ (posedge clk_i or posedge rst_i)
+if (rst_i)
+    result_q  <= 32'b0;
+else if (~hold_i)
+    result_q <= alu_p_w;
+
+assign writeback_value_o  = result_q;
+
+//-----------------------------------------------------------------
+// less_than_signed: Less than operator (signed)
+// Inputs: x = left operand, y = right operand
+// Return: (int)x < (int)y
+//-----------------------------------------------------------------
+function [0:0] less_than_signed;
+    input  [31:0] x;
+    input  [31:0] y;
+    reg [31:0] v;
+begin
+    v = (x - y);
+    if (x[31] != y[31])
+        less_than_signed = x[31];
+    else
+        less_than_signed = v[31];
+end
+endfunction
+
+//-----------------------------------------------------------------
+// greater_than_signed: Greater than operator (signed)
+// Inputs: x = left operand, y = right operand
+// Return: (int)x > (int)y
+//-----------------------------------------------------------------
+function [0:0] greater_than_signed;
+    input  [31:0] x;
+    input  [31:0] y;
+    reg [31:0] v;
+begin
+    v = (y - x);
+    if (x[31] != y[31])
+        greater_than_signed = y[31];
+    else
+        greater_than_signed = v[31];
+end
+endfunction
+
+//-------------------------------------------------------------
+// Execute - Branch operations
+//-------------------------------------------------------------
+reg        branch_r;
+reg        branch_taken_r;
+reg [31:0] branch_target_r;
+reg        branch_call_r;
+reg        branch_ret_r;
+reg        branch_jmp_r;
+
+always @ *
+begin
+    branch_r        = 1'b0;
+    branch_taken_r  = 1'b0;
+    branch_call_r   = 1'b0;
+    branch_ret_r    = 1'b0;
+    branch_jmp_r    = 1'b0;
+
+    // Default branch_r target is relative to current PC
+    branch_target_r = opcode_pc_i + bimm_r;
+
+    if ((opcode_opcode_i & `INST_JAL_MASK) == `INST_JAL) // jal
+    begin
+        branch_r        = 1'b1;
+        branch_taken_r  = 1'b1;
+        branch_target_r = opcode_pc_i + jimm20_r;
+        branch_call_r   = (opcode_rd_idx_i == 5'd1); // RA
+        branch_jmp_r    = 1'b1;
+    end
+    else if ((opcode_opcode_i & `INST_JALR_MASK) == `INST_JALR) // jalr
+    begin
+        branch_r            = 1'b1;
+        branch_taken_r      = 1'b1;
+        branch_target_r     = opcode_ra_operand_i + imm12_r;
+        branch_target_r[0]  = 1'b0;
+        branch_ret_r        = (opcode_ra_idx_i == 5'd1 && imm12_r[11:0] == 12'b0); // RA
+        branch_call_r       = ~branch_ret_r && (opcode_rd_idx_i == 5'd1); // RA
+        branch_jmp_r        = ~(branch_call_r | branch_ret_r);
+    end
+    else if ((opcode_opcode_i & `INST_BEQ_MASK) == `INST_BEQ) // beq
+    begin
+        branch_r      = 1'b1;
+        branch_taken_r= (opcode_ra_operand_i == opcode_rb_operand_i);
+    end
+    else if ((opcode_opcode_i & `INST_BNE_MASK) == `INST_BNE) // bne
+    begin
+        branch_r      = 1'b1;    
+        branch_taken_r= (opcode_ra_operand_i != opcode_rb_operand_i);
+    end
+    else if ((opcode_opcode_i & `INST_BLT_MASK) == `INST_BLT) // blt
+    begin
+        branch_r      = 1'b1;
+        branch_taken_r= less_than_signed(opcode_ra_operand_i, opcode_rb_operand_i);
+    end
+    else if ((opcode_opcode_i & `INST_BGE_MASK) == `INST_BGE) // bge
+    begin
+        branch_r      = 1'b1;    
+        branch_taken_r= greater_than_signed(opcode_ra_operand_i,opcode_rb_operand_i) | (opcode_ra_operand_i == opcode_rb_operand_i);
+    end
+    else if ((opcode_opcode_i & `INST_BLTU_MASK) == `INST_BLTU) // bltu
+    begin
+        branch_r      = 1'b1;    
+        branch_taken_r= (opcode_ra_operand_i < opcode_rb_operand_i);
+    end
+    else if ((opcode_opcode_i & `INST_BGEU_MASK) == `INST_BGEU) // bgeu
+    begin
+        branch_r      = 1'b1;
+        branch_taken_r= (opcode_ra_operand_i >= opcode_rb_operand_i);
+    end
+end
+
+reg        branch_taken_q;
+reg        branch_ntaken_q;
+reg [31:0] pc_x_q;
+reg [31:0] pc_m_q;
+reg        branch_call_q;
+reg        branch_ret_q;
+reg        branch_jmp_q;
+
+always @ (posedge clk_i or posedge rst_i)
+if (rst_i)
+begin
+    branch_taken_q   <= 1'b0;
+    branch_ntaken_q  <= 1'b0;
+    pc_x_q           <= 32'b0;
+    pc_m_q           <= 32'b0;
+    branch_call_q    <= 1'b0;
+    branch_ret_q     <= 1'b0;
+    branch_jmp_q     <= 1'b0;
+end
+else if (opcode_valid_i)
+begin
+    branch_taken_q   <= branch_r && opcode_valid_i & branch_taken_r;
+    branch_ntaken_q  <= branch_r && opcode_valid_i & ~branch_taken_r;
+    pc_x_q           <= branch_taken_r ? branch_target_r : opcode_pc_i + 32'd4;
+    branch_call_q    <= branch_r && opcode_valid_i && branch_call_r;
+    branch_ret_q     <= branch_r && opcode_valid_i && branch_ret_r;
+    branch_jmp_q     <= branch_r && opcode_valid_i && branch_jmp_r;
+    pc_m_q           <= opcode_pc_i;
+end
+
+assign branch_request_o   = branch_taken_q | branch_ntaken_q;
+assign branch_is_taken_o  = branch_taken_q;
+assign branch_is_not_taken_o = branch_ntaken_q;
+assign branch_source_o    = pc_m_q;
+assign branch_pc_o        = pc_x_q;
+assign branch_is_call_o   = branch_call_q;
+assign branch_is_ret_o    = branch_ret_q;
+assign branch_is_jmp_o    = branch_jmp_q;
+
+assign branch_d_request_o = (branch_r && opcode_valid_i && branch_taken_r);
+assign branch_d_pc_o      = branch_target_r;
+assign branch_d_priv_o    = 2'b0; // don't care
+
+
+
+endmodule
diff --git a/tb/cpu/tb_exec_decode.v b/tb/cpu/tb_exec_decode.v
new file mode 100644
--- /dev/null
+++ b/tb/cpu/tb_exec_decode.v
@@ -0,0 +1,127 @@
+// Full execution interface miter; includes invalid-slot payload and X/Z data.
+`timescale 1ns / 1ps
+`ifndef CPU_EXEC_MODULE
+`define CPU_EXEC_MODULE biriscv_exec
+`endif
+module tb_exec_decode #(parameter BROKEN=0);
+    reg clk=0, rst=1, valid=0, invalid=0, hold=0;
+    always #5 clk=~clk;
+    reg [31:0] op=0, pc=0, ra=0, rb=0;
+    reg [4:0] rd_idx=0, ra_idx=0, rb_idx=0;
+    wire [136:0] reference_value, candidate_value;
+    reg [31:0] random_q=32'hc361f25a, corrupt_pc=0;
+    integer i, checks=0;
+
+    biriscv_exec u_reference (
+        .clk_i(clk),.rst_i(rst),.opcode_valid_i(valid),.opcode_opcode_i(op),
+        .opcode_pc_i(pc),.opcode_invalid_i(invalid),.opcode_rd_idx_i(rd_idx),
+        .opcode_ra_idx_i(ra_idx),.opcode_rb_idx_i(rb_idx),
+        .opcode_ra_operand_i(ra),.opcode_rb_operand_i(rb),.hold_i(hold),
+        .writeback_value_o(reference_value[136:105]),
+        .branch_pc_o(reference_value[104:73]),.branch_d_pc_o(reference_value[72:41]),
+        .branch_source_o(reference_value[40:9]),.branch_d_priv_o(reference_value[8:7]),
+        .branch_request_o(reference_value[6]),.branch_is_taken_o(reference_value[5]),
+        .branch_is_not_taken_o(reference_value[4]),.branch_is_call_o(reference_value[3]),
+        .branch_is_ret_o(reference_value[2]),.branch_is_jmp_o(reference_value[1]),
+        .branch_d_request_o(reference_value[0])
+    );
+    wire [8:0] ctrl;
+    triha_alu_decode u_decode (.opcode_i(op),.control_o(ctrl));
+    triha_exec u_candidate (
+        .opcode_alu_i(ctrl),
+        .clk_i(clk),.rst_i(rst),.opcode_valid_i(valid),.opcode_opcode_i(op),
+        .opcode_pc_i(pc),.opcode_invalid_i(invalid),.opcode_rd_idx_i(rd_idx),
+        .opcode_ra_idx_i(ra_idx),.opcode_rb_idx_i(rb_idx),
+        .opcode_ra_operand_i(ra),.opcode_rb_operand_i(rb),.hold_i(hold),
+        .writeback_value_o(candidate_value[136:105]),
+        .branch_pc_o(candidate_value[104:73]),.branch_d_pc_o(candidate_value[72:41]),
+        .branch_source_o(candidate_value[40:9]),.branch_d_priv_o(candidate_value[8:7]),
+        .branch_request_o(candidate_value[6]),.branch_is_taken_o(candidate_value[5]),
+        .branch_is_not_taken_o(candidate_value[4]),.branch_is_call_o(candidate_value[3]),
+        .branch_is_ret_o(candidate_value[2]),.branch_is_jmp_o(candidate_value[1]),
+        .branch_d_request_o(candidate_value[0])
+    );
+    task random_next;
+        begin
+            random_q=random_q^(random_q<<13);
+            random_q=random_q^(random_q>>17);
+            random_q=random_q^(random_q<<5);
+        end
+    endtask
+    task compare_outputs;
+        begin
+            if(reference_value !== candidate_value)
+                $fatal(1,"EXEC_DECODE_FAIL check=%0d op=%h pc=%h a=%h b=%h got=%h expected=%h",
+                    checks,op,pc,ra,rb,candidate_value,reference_value);
+        end
+    endtask
+    task step;
+        begin
+            #1; compare_outputs;
+            @(posedge clk); #1;
+            if(BROKEN && checks==100) begin
+                corrupt_pc=reference_value[104:73]^32'h80000000;
+                force u_candidate.pc_x_q=corrupt_pc;
+            end
+            compare_outputs;
+            checks=checks+1;
+            @(negedge clk);
+        end
+    endtask
+    initial begin
+        step;
+        for(i=0;i<211072;i=i+1) begin
+            random_next; op=random_q;
+            case(i%16)
+                0: op={op[31:15],3'b000,op[11:7],7'h63}; // BEQ
+                1: op={op[31:15],3'b001,op[11:7],7'h63}; // BNE
+                2: op={op[31:15],3'b100,op[11:7],7'h63}; // BLT
+                3: op={op[31:15],3'b101,op[11:7],7'h63}; // BGE
+                4: op={op[31:15],3'b110,op[11:7],7'h63}; // BLTU
+                5: op={op[31:15],3'b111,op[11:7],7'h63}; // BGEU
+                6: op={op[31:7],7'h6f}; // JAL
+                7: op={op[31:15],3'b000,op[11:7],7'h67}; // JALR
+                8: op={op[31:7],7'h17}; // AUIPC
+                9: op={op[31:7],7'h13}; // OP-IMM
+                10: op={7'b0,op[24:7],7'h33}; // OP
+                11: op={op[31:7],7'h37}; // LUI
+                default: op=op;
+            endcase
+            // Exhaust every opcode/funct3/funct7 combination before the
+            // structured branch/ALU sweep; other fields and operands vary.
+            if(i<131072) op={i[16:10],op[24:15],i[9:7],op[11:7],i[6:0]};
+            random_next; pc=random_q;
+            random_next; ra=random_q;
+            random_next; rb=random_q;
+            case((i/16)%8)
+                0: rb=ra;
+                1: begin ra=32'h80000000;rb=32'h7fffffff;end
+                2: begin ra=32'h7fffffff;rb=32'h80000000;end
+                3: begin ra=0;rb=32'hffffffff;end
+                4: begin ra=32'hffffffff;rb=0;end
+                5: begin pc=32'hfffffffc;ra=32'hffffffff;rb=1;end
+                default: rb=rb;
+            endcase
+            rd_idx=op[11:7];ra_idx=op[19:15];rb_idx=op[24:20];
+            valid=(i%7)!=0;invalid=(i%11)==0;hold=(i%5)==0;rst=(i%257)==0;
+            if(i>210072) begin
+                case(i%11)
+                    0: ra[15]=1'bx;
+                    1: rb[31]=1'bz;
+                    2: pc[6]=1'bx;
+                    3: op[14]=1'bx;
+                    4: op[0]=1'bz;
+                    5: valid=1'bx;
+                    6: hold=1'bz;
+                    7: rd_idx=5'bx;
+                    8: ra_idx=5'bz;
+                    9: invalid=1'bx;
+                    default: begin op=32'h12345037;op[19]=1'bz;end
+                endcase
+            end
+            step;
+        end
+        $display("EXEC_DECODE_PASS checks=%0d",checks);
+        $finish;
+    end
+endmodule
diff --git a/tb/cpu/tb_fifo_alu_decode.v b/tb/cpu/tb_fifo_alu_decode.v
new file mode 100644
--- /dev/null
+++ b/tb/cpu/tb_fifo_alu_decode.v
@@ -0,0 +1,124 @@
+// Descriptor and raw instruction must stay aligned even in invalid FIFO slots.
+`timescale 1ns/1ps
+module tb_fifo_alu_decode #(parameter BROKEN=0, parameter DECODE_STAGE=0);
+    reg clk=0, rst=1, push=0, flush=0, pop0=0, pop1=0, hold=0;
+    reg fault_fetch=0, fault_page=0;
+    reg [63:0] data=0;
+    reg [31:0] pc=0, ra=0, rb=0, random_q=32'h51ca738d;
+    reg [1:0] pred=0;
+    wire [31:0] op[1:0], out_pc[1:0];
+    wire [8:0] ctrl[1:0];
+    wire [136:0] reference_value[1:0], candidate_value[1:0];
+    wire valid[1:0];
+    integer checks=0,n,lane;
+    always #5 clk=~clk;
+    triha_decode #(.EXTRA_DECODE_STAGE(DECODE_STAGE)) u_decode (
+        .clk_i(clk),.rst_i(rst),.fetch_in_valid_i(push),.fetch_in_instr_i(data),
+        .fetch_in_pred_branch_i(pred),.fetch_in_fault_fetch_i(fault_fetch),
+        .fetch_in_fault_page_i(fault_page),.fetch_in_pc_i(pc),
+        .fetch_out0_accept_i(pop0),.fetch_out1_accept_i(pop1),
+        .branch_request_i(flush),.branch_pc_i(32'b0),.branch_priv_i(2'b0),
+        .fetch_out0_valid_o(valid[0]),.fetch_out0_instr_o(op[0]),.fetch_out0_pc_o(out_pc[0]),
+        .fetch_out1_valid_o(valid[1]),.fetch_out1_instr_o(op[1]),.fetch_out1_pc_o(out_pc[1]),
+        .fetch_out0_alu_o(ctrl[0]),.fetch_out1_alu_o(ctrl[1])
+    );
+    genvar g;
+    generate for(g=0;g<2;g=g+1) begin: g_lane
+    biriscv_exec u_reference (
+        .clk_i(clk),.rst_i(rst),.opcode_valid_i(valid[g]),.opcode_opcode_i(op[g]),
+        .opcode_pc_i(out_pc[g]),.opcode_invalid_i(1'b0),.opcode_rd_idx_i(op[g][11:7]),
+        .opcode_ra_idx_i(op[g][19:15]),.opcode_rb_idx_i(op[g][24:20]),
+        .opcode_ra_operand_i(ra),.opcode_rb_operand_i(rb),.hold_i(hold),
+        .writeback_value_o(reference_value[g][136:105]),
+        .branch_pc_o(reference_value[g][104:73]),.branch_d_pc_o(reference_value[g][72:41]),
+        .branch_source_o(reference_value[g][40:9]),.branch_d_priv_o(reference_value[g][8:7]),
+        .branch_request_o(reference_value[g][6]),.branch_is_taken_o(reference_value[g][5]),
+        .branch_is_not_taken_o(reference_value[g][4]),.branch_is_call_o(reference_value[g][3]),
+        .branch_is_ret_o(reference_value[g][2]),.branch_is_jmp_o(reference_value[g][1]),
+        .branch_d_request_o(reference_value[g][0])
+    );
+    wire [8:0] selected_ctrl = ctrl[g] ^
+        ((BROKEN && checks>=100 && g==0 && op[g][6:0]==7'h13) ? 9'h008 : 9'b0);
+    triha_exec u_candidate (
+        .opcode_alu_i(selected_ctrl),
+        .clk_i(clk),.rst_i(rst),.opcode_valid_i(valid[g]),.opcode_opcode_i(op[g]),
+        .opcode_pc_i(out_pc[g]),.opcode_invalid_i(1'b0),.opcode_rd_idx_i(op[g][11:7]),
+        .opcode_ra_idx_i(op[g][19:15]),.opcode_rb_idx_i(op[g][24:20]),
+        .opcode_ra_operand_i(ra),.opcode_rb_operand_i(rb),.hold_i(hold),
+        .writeback_value_o(candidate_value[g][136:105]),
+        .branch_pc_o(candidate_value[g][104:73]),.branch_d_pc_o(candidate_value[g][72:41]),
+        .branch_source_o(candidate_value[g][40:9]),.branch_d_priv_o(candidate_value[g][8:7]),
+        .branch_request_o(candidate_value[g][6]),.branch_is_taken_o(candidate_value[g][5]),
+        .branch_is_not_taken_o(candidate_value[g][4]),.branch_is_call_o(candidate_value[g][3]),
+        .branch_is_ret_o(candidate_value[g][2]),.branch_is_jmp_o(candidate_value[g][1]),
+        .branch_d_request_o(candidate_value[g][0])
+    );
+    end endgenerate
+    task random_next;
+        begin
+            random_q=random_q^(random_q<<13);
+            random_q=random_q^(random_q>>17);
+            random_q=random_q^(random_q<<5);
+        end
+    endtask
+    task compare_outputs;
+        begin
+            for(lane=0;lane<2;lane=lane+1)
+                if(reference_value[lane] !== candidate_value[lane])
+                    $fatal(1,"FIFO_ALU_DECODE_FAIL check=%0d lane=%0d op=%h ctrl=%h got=%h expected=%h",
+                        checks,lane,op[lane],ctrl[lane],candidate_value[lane],reference_value[lane]);
+        end
+    endtask
+    task step;
+        begin
+            #1; compare_outputs;
+            @(posedge clk); #1; compare_outputs;
+            checks=checks+1; @(negedge clk);
+        end
+    endtask
+    initial begin
+        step;
+        for(n=0;n<12000;n=n+1) begin
+            random_next; data[31:0]=random_q;
+            // All ALU operation classes plus malformed/random words.
+            case(n%6)
+                0: data[6:0]=7'h13;
+                1: begin data[6:0]=7'h33;data[31:25]=0;end
+                2: data[6:0]=7'h37;
+                3: data[6:0]=7'h17;
+                4: begin data[6:0]=7'h67;data[14:12]=0;end
+            endcase
+            random_next; data[63:32]=random_q;
+            case(n%6)
+                0: begin data[38:32]=7'h33;data[63:57]=0;end
+                1: data[38:32]=7'h13;
+                2: data[38:32]=7'h6f;
+                3: data[38:32]=7'h37;
+            endcase
+            random_next; pc={random_q[31:3],3'b0}; ra=random_q;
+            random_next; rb=random_q;
+            push=random_q[0];pop0=random_q[1];pop1=random_q[2];pred=random_q[9:8];
+            flush=(n%37)==0;hold=(n%5)==0;rst=(n%257)==0;
+            fault_fetch=(n%51)==0;fault_page=(n%43)==0;
+            // Long empty, fill/full, partial-pop and flush-during-fill phases.
+            if(n<100) begin push=0;pop0=0;pop1=0;flush=0;end
+            if(n>=100 && n<130) begin push=1;pop0=0;pop1=0;end
+            if(n>=130 && n<140) begin push=0;pop0=1;pop1=0;end
+            if(n>=140 && n<150) begin push=1;pop0=1;pop1=1;flush=1;end
+            if(n>11000) begin
+                case(n%8)
+                    0: data[14]=1'bx;
+                    1: data[63]=1'bz;
+                    2: begin data[31:0]=32'h12345037;data[19]=1'bz;end
+                    3: ra[15]=1'bz;
+                    4: rb[31]=1'bx;
+                    5: pc[15]=1'bx;
+                    6: hold=1'bx;
+                endcase
+            end
+            step;
+        end
+        $display("FIFO_ALU_DECODE_PASS stage=%0d checks=%0d lanes=2 invalid_flush_full_xz",DECODE_STAGE,checks);
+        $finish;
+    end
+endmodule
