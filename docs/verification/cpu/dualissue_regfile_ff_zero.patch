+     input           clk_i
+    ,input           rst_i
+    ,input           opcode_valid_i
+    ,input  [ 31:0]  opcode_opcode_i
+    ,input [8:0] alu_decode_i
+    ,input  [ 31:0]  opcode_pc_i
