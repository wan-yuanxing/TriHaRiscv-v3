diff --git a/tb/cpu/tb_cpu_dcache_store_overlap.v b/tb/cpu/tb_cpu_dcache_store_overlap.v
new file mode 100644
--- /dev/null
+++ b/tb/cpu/tb_cpu_dcache_store_overlap.v
@@ -0,0 +1,251 @@
+`timescale 1ns/1ps
+// Independent lower-memory oracle. Only the public request/response interface
+// is used for throughput, response ownership and registered-latency checks.
+module tb_cpu_dcache_store_overlap;
+    parameter integer CORRUPT_DATA=0;
+    reg clk=0, rst_n=0;
+    always #5 clk=!clk;
+    integer cycles=0, checks=0, reads=0, writes=0;
+    reg [31:0] memory[0:65535];
+    reg [31:0] addr=0, wdata=0, random_q=32'h93b781af;
+    reg rd=0, cacheable=1, inval=0, clean=0, flush=0;
+    reg [3:0] mask=0;
+    reg [10:0] tag=0;
+    wire accept, ack, error;
+    wire [10:0] resp_tag;
+    wire [31:0] rdata, lower_addr, lower_data;
+    wire lower_rd;
+    wire [3:0] lower_wr;
+    wire [7:0] lower_len;
+    reg lower_ack=0, lower_error=0, pending=0;
+    reg [31:0] lower_rdata=0, saved_addr, saved_data;
+    reg [3:0] saved_mask;
+    integer beat=0, last=0, delay_count=0;
+    wire lower_accept=!pending && !lower_ack && random_q[2];
+    reg fail_read=0, fail_write=0, malformed_next=0;
+    task check;
+        input ok;
+        input [511:0] message;
+        begin
+            checks=checks+1;
+            if(ok!==1'b1) begin
+                $display("CPU_DCACHE_STORE_OVERLAP_FAIL %0s cycle=%0d",message,cycles);
+                $fatal(1);
+            end
+        end
+    endtask
+    triha_dcache u_dut (
+        .clk_i(clk),.rst_ni(rst_n),.mem_addr_i(addr),.mem_data_wr_i(wdata),
+        .mem_rd_i(rd),.mem_wr_i(mask),.mem_cacheable_i(cacheable),.mem_req_tag_i(tag),
+        .mem_invalidate_i(inval),.mem_writeback_i(clean),.mem_flush_i(flush),
+        .mem_data_rd_o(rdata),.mem_accept_o(accept),.mem_ack_o(ack),
+        .mem_error_o(error),.mem_resp_tag_o(resp_tag),
+        .outport_accept_i(lower_accept),.outport_ack_i(lower_ack),
+        .outport_error_i(lower_error),.outport_read_data_i(lower_rdata),
+        .outport_rd_o(lower_rd),.outport_wr_o(lower_wr),.outport_len_o(lower_len),
+        .outport_addr_o(lower_addr),.outport_write_data_o(lower_data)
+    );
+    integer lane;
+    always @(posedge clk) begin
+        cycles<=cycles+1;
+        random_q<={random_q[30:0],random_q[31]^random_q[21]^random_q[1]^random_q[0]};
+        if(cycles>100000) check(0,"watchdog");
+        if(!rst_n) begin pending<=0; lower_ack<=0; lower_error<=0; end
+        else begin
+            lower_ack<=0; lower_error<=0;
+            if(lower_accept && (lower_rd || |lower_wr)) begin
+                pending<=1; saved_addr<=lower_addr; saved_data<=lower_data;
+                saved_mask<=lower_wr; beat<=0; last<=lower_len; delay_count<=3;
+                if(lower_rd) reads<=reads+1; else writes<=writes+1;
+            end
+            if(pending && !lower_ack) begin
+                if(delay_count>0) delay_count<=delay_count-1;
+                else if(random_q[4]) begin
+                    lower_ack<=1; lower_error<=saved_mask==0 ? fail_read : fail_write;
+                    lower_rdata<=memory[(saved_addr[17:2]+beat)&65535]^CORRUPT_DATA;
+                    for(lane=0;lane<4;lane=lane+1)
+                        if(saved_mask[lane] && !fail_write) memory[saved_addr[17:2]][lane*8+:8]<=saved_data[lane*8+:8];
+                    if(beat==last) pending<=0; else beat<=beat+1;
+                end
+            end
+        end
+    end
+    task send;
+        input [31:0] a;
+        input [3:0] m;
+        input [31:0] value;
+        input cached;
+        input expect_error;
+        input [31:0] expected;
+        reg [10:0] saved_tag;
+        integer guard;
+        begin
+            @(negedge clk); addr=a; mask=m; wdata=value; rd=m==0; cacheable=cached;
+            tag=tag+1; saved_tag=tag; guard=0;
+            begin: await_accept
+                forever begin @(posedge clk); if(accept) disable await_accept; end
+            end
+            @(negedge clk); rd=0; mask=0;
+            while(!ack) begin @(negedge clk); guard=guard+1; if(guard>20000) check(0,"response timeout"); end
+            check(resp_tag===saved_tag && error===expect_error,"serialized response ownership/error");
+            if(!expect_error && m==0) check(rdata===expected,"serialized architectural load");
+            if(expect_error || !cached) check(!accept,"error and uncached response remain serialized");
+            @(negedge clk);
+        end
+    endtask
+    // The completing store and successor are offered on consecutive source
+    // cycles. Only public handshakes determine acceptance and response order.
+    task store_pair;
+        input [31:0] a;
+        input [3:0] m;
+        input [31:0] value;
+        input [31:0] next_a;
+        input [3:0] next_m;
+        input [31:0] next_value;
+        input next_cached;
+        input integer maintenance;
+        input expected_overlap;
+        input expected_error;
+        input [31:0] expected_load;
+        reg [10:0] old_tag, next_tag;
+        integer guard;
+        begin
+            @(negedge clk); addr=a; mask=m; wdata=value; rd=0; cacheable=1;
+            tag=tag+1; old_tag=tag;
+            begin: first_accept
+                forever begin @(posedge clk); if(accept) disable first_accept; end
+            end
+            @(negedge clk);
+            addr=next_a; mask=next_m; wdata=next_value; cacheable=next_cached;
+            rd=(maintenance==0 && next_m==0) || malformed_next;
+            clean=maintenance==1; inval=maintenance==2; flush=maintenance==3;
+            tag=tag+1; next_tag=tag; guard=0;
+            while(!ack) begin @(negedge clk); guard=guard+1; if(guard>30000) check(0,"first store timeout"); end
+            check(!error && resp_tag===old_tag,"old store owns completion tag");
+            check(accept===expected_overlap,"different-set store response acceptance contract");
+            @(posedge clk);
+            check(ack && !error && resp_tag===old_tag,"store response stable through completion edge");
+            if(!expected_overlap) begin
+                @(negedge clk);
+                check(!ack,"serial successor does not reuse old ack");
+                begin: serial_accept
+                    forever begin @(posedge clk); if(accept) disable serial_accept; end
+                end
+            end
+            @(negedge clk); rd=0; mask=0; clean=0; inval=0; flush=0;
+            if(expected_error) begin
+                addr=32'h80001e04; mask=4'hf; wdata=32'hdeadbeef; tag=tag+1;
+            end
+            while(!ack) begin @(negedge clk); guard=guard+1; if(guard>30000) check(0,"successor timeout"); end
+            check(error===expected_error && resp_tag===next_tag,"successor response tag/error ownership");
+            if(!expected_error && maintenance==0 && next_m==0)
+                check(rdata===expected_load,"successor load gets exact architectural bytes");
+            if(expected_error) check(!accept,"failed successor remains serialized");
+            @(negedge clk); mask=0;
+        end
+    endtask
+    task maintenance_op;
+        input [31:0] a;
+        input integer operation;
+        reg [10:0] saved_tag;
+        begin
+            @(negedge clk); addr=a; tag=tag+1; saved_tag=tag;
+            rd=0; mask=0; clean=operation==1; inval=operation==2; flush=operation==3;
+            begin: take_maintenance
+                forever begin @(posedge clk); if(accept) disable take_maintenance; end
+            end
+            @(negedge clk); clean=0; inval=0; flush=0;
+            while(!ack) @(negedge clk);
+            check(!error && resp_tag===saved_tag,"maintenance succeeds with own tag");
+            @(negedge clk);
+        end
+    endtask
+    integer n, before_reads, before_writes;
+    reg [31:0] expected_a;
+    initial begin
+        for(n=0;n<65536;n=n+1) memory[n]=32'h3157c8a9^(n*32'h7acd139);
+        repeat(4) @(negedge clk); rst_n=1;
+        // Two resident ways at each of two different sets.
+        send(32'h80000100,0,0,1,0,memory['h40]);
+        send(32'h80002100,0,0,1,0,memory['h840]);
+        send(32'h80000204,0,0,1,0,memory['h81]);
+        send(32'h80002204,0,0,1,0,memory['h881]);
+        store_pair(32'h80000100,4'hf,32'h12345678,32'h80000204,0,0,1,0,1,0,memory['h81]);
+        send(32'h80000100,0,0,1,0,32'h12345678);
+        // Partial-byte old store and second-way destination, then both dirty
+        // ways are read and cleaned to prove old data and dirty tag survived.
+        store_pair(32'h80002100,4'h5,32'h89abcdef,32'h80002204,4'hf,32'h68123745,1,0,1,0,0);
+        expected_a=(memory['h840]&32'hff00ff00)|32'h00ab00ef;
+        send(32'h80002100,0,0,1,0,expected_a);
